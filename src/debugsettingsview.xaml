<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.DebugSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="Debug" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
      <TextBlock Text="Local battle debug presets. Everything is off by default and nothing is written to your account save." Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
      <Border BorderBrush="{StaticResource TextFaintBrush}" BorderThickness="1" Background="{StaticResource PlateHighBrush}" Padding="12" Margin="0,0,0,18">
        <TextBlock Text="Fixed damage is confirmed in game. The other options are wired into the verified build and take effect about a second after you save. How far they reach on Noble Phantasms and special enemies still needs testing in battle." Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" />
      </Border>
      <TabControl MinWidth="0">
        <TabItem Header="Cheats">
          <StackPanel Margin="18">
            <CheckBox Name="OneHit" Content="Fixed Damage 999999" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Every hit you land deals exactly 999999 damage; your listed ATK is not changed, and turning this off restores normal damage." Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" Margin="24,0,0,14" />
            <CheckBox Name="AttackStun" Content="Attacks Cause Stun" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Landing a hit asks the game for its own stun; immunity, recovery intervals and the normal wear-off rules all still apply. Guarded and missed attacks do not trigger it." Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" Margin="24,0,0,14" />
            <CheckBox Name="FullNp" Content="Keep NP Full" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Holds your Servant at the highest NP charge currently available, and refills it after you use it." Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
            <CheckBox Name="InstantNoble" Content="Instant Noble Phantasm" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Skips the Noble Phantasm charge-up wait; the NP cutscene and the normal damage calculation are unchanged." Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
            <CheckBox Name="Invincible" Content="Invincible" Margin="0,8" Checked="Option_OnChanged" Unchecked="Option_OnChanged" />
            <TextBlock Text="Enemy attacks no longer take your HP; scripted story defeats still happen, and enemies themselves are not changed." Foreground="{StaticResource TextSoftBrush}" Margin="24,0,0,14" />
          </StackPanel>
        </TabItem>
      </TabControl>
      <WrapPanel Margin="0,18,0,12">
        <Button Content="Save" Width="150" Height="40" Margin="0,0,8,0" Click="Save_OnClick" />
        <Button Content="Turn All Off" Width="150" Height="40" Click="DisableAll_OnClick" />
      </WrapPanel>
      <TextBlock Name="StatusText" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>