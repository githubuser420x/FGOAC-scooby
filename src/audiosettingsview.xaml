<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.AudioSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Text="游戏音量" FontSize="22" FontWeight="Bold" Margin="0,0,0,12" />
      <TextBlock Text="分别调整语音、背景音乐和音效。拖动滑块即可保存，游戏运行时实时应用。" TextWrapping="Wrap" Foreground="#FFB0C4DE" Margin="0,0,0,24" />
      <Grid MinWidth="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="64" />
          <RowDefinition Height="64" />
          <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <TextBlock Text="语音" VerticalAlignment="Center" FontSize="17" />
        <Slider Name="VoiceSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,20,0" ValueChanged="Volume_OnChanged" />
        <TextBlock Grid.Column="2" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=VoiceSlider, StringFormat={}{0:0}}" />
        <TextBlock Text="BGM" Grid.Row="1" VerticalAlignment="Center" FontSize="17" />
        <Slider Name="BgmSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,20,0" ValueChanged="Volume_OnChanged" />
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=BgmSlider, StringFormat={}{0:0}}" />
        <TextBlock Text="音效" Grid.Row="2" VerticalAlignment="Center" FontSize="17" />
        <Slider Name="EffectsSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,20,0" ValueChanged="Volume_OnChanged" />
        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Value, ElementName=EffectsSlider, StringFormat={}{0:0}}" />
      </Grid>
      <WrapPanel Margin="0,24,0,16">
        <Button Content="应用音量设置" Width="150" Height="40" Margin="0,0,8,0" Click="Apply_OnClick" />
        <Button Content="全部静音" Width="150" Height="40" Margin="0,0,8,0" Click="Mute_OnClick" />
        <Button Content="恢复默认音量" Width="150" Height="40" Click="Defaults_OnClick" />
      </WrapPanel>
      <TextBlock Name="StatusText" TextWrapping="Wrap" Foreground="#FFB0C4DE" />
      <TextBlock Text="0 为静音，100 为原始音量。不会改变 Windows 主音量或其他程序的声音。影片中已混合在一起的声音不能再拆分。" TextWrapping="Wrap" Foreground="#FFB0C4DE" Margin="0,16,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>