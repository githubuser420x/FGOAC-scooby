<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ControlSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Text="控制" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
      <WrapPanel>
        <TextBlock Text="控制方法" VerticalAlignment="Center" Margin="3,0,12,0" />
        <ComboBox Name="InputModeSelector" Width="250" SelectedIndex="0" SelectionChanged="InputMode_OnChanged">
          <ComboBoxItem Content="键盘鼠标" Tag="keyboard" />
          <ComboBoxItem Content="XInput 手柄" Tag="xinput" />
          <ComboBoxItem Content="PS5 DualSense 手柄（原生）" Tag="xinput" />
        </ComboBox>
      </WrapPanel>
      <TextBlock Text="鼠标左键用于界面触摸。键盘公共按键在所有控制方式下均可用。保存后下次启动游戏生效。" TextWrapping="Wrap" Foreground="#BFB5C2" Margin="3,8,0,16" />
      <StackPanel Name="KeyboardPanel">
        <TextBlock Text="键盘 / 鼠标映射" FontSize="17" FontWeight="Bold" Margin="3,0,0,8" />
        <ItemsControl Name="KeyboardMappings" MaxWidth="500" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Name="ControllerPanel" Visibility="Collapsed">
        <TextBlock Name="ControllerMappingTitle" Text="XInput 手柄映射" TextAlignment="Center" FontSize="17" FontWeight="Bold" Margin="3,0,0,8" />
        <TextBlock Name="DualSenseHelp" Visibility="Collapsed" Text="支持 DualSense / DualSense Edge 的 USB 和蓝牙连接。请先保存 PS5 模式，再检测手柄。若已使用 DS4Windows 或 Steam Input 转为 Xbox 手柄，请选择 XInput 模式，避免重复输入。" Foreground="#BFB5C2" TextWrapping="Wrap" Margin="3,0,0,12" />
        <ItemsControl Name="ControllerMappings" MaxWidth="500" HorizontalAlignment="Stretch">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                <Setter Property="TextBlock.TextAlignment" Value="Center" />
              </Style>
              <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </ItemsControl>
        <WrapPanel Margin="0,8">
          <TextBlock Text="移动" VerticalAlignment="Center" Margin="3,0,8,0" />
          <ComboBox Name="MovementSelector" Width="130" SelectedIndex="0">
            <ComboBoxItem Content="左摇杆" />
            <ComboBoxItem Content="右摇杆" />
            <ComboBoxItem Content="十字键" />
          </ComboBox>
          <TextBlock Text="手柄序号" VerticalAlignment="Center" Margin="12,0,8,0" />
          <ComboBox Name="ControllerSelector" Width="65" SelectedIndex="0">
            <ComboBoxItem Content="1" />
            <ComboBoxItem Content="2" />
            <ComboBoxItem Content="3" />
            <ComboBoxItem Content="4" />
          </ComboBox>
          <TextBlock Text="摇杆死区" VerticalAlignment="Center" Margin="12,0,8,0" />
          <TextBox Name="DeadzoneInput" Width="90" Text="7849" TextAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFFFFF" Background="#18131B" CaretBrush="#FFFFFFFF" />
        </WrapPanel>
        <TextBlock Name="ControllerDeadzoneHelp" Text="死区范围 0–32766，默认 7849。LT / RT 按下阈值为 64；界面仍使用鼠标或触屏。" Foreground="#BFB5C2" TextWrapping="Wrap" Margin="3,0,0,12" />
        <CheckBox Name="RumbleEnabled" Content="启用手柄震动（攻击、命中与受击）" Foreground="#FFFFFFFF" Margin="3,8" />
        <WrapPanel Margin="3,4,0,8">
          <TextBlock Text="震动强度" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Slider Name="RumbleStrength" Minimum="0" Maximum="100" Value="70" TickFrequency="1" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center" />
          <TextBlock Width="55" Margin="10,0" VerticalAlignment="Center" Text="{Binding ElementName=RumbleStrength, Path=Value, StringFormat={}{0:0}%}" />
          <Button Name="RumbleTestButton" Content="测试震动" Click="RumbleTest_OnClick" />
          <Button Content="检测手柄" Click="DetectController_OnClick" />
        </WrapPanel>
        <TextBlock Text="攻击强度（再乘以上方总强度）" FontWeight="Bold" Margin="3,8" />
        <ItemsControl Name="CardRumbleSettings" />
        <TextBlock Text="攻击震动跟随实际攻击动画，结束或被打断时停止；命中和受击另有短暂反馈。使用上方选择的手柄，切出游戏和摄影模式会停止震动。" Foreground="#BFB5C2" TextWrapping="Wrap" Margin="3,0,0,12" />
        <Expander Name="DualSenseCalibrationPanel" Header="DualSense 实体按键校正" Foreground="#FFFFFFFF" Visibility="Collapsed" Margin="3,12,0,8">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Text="识别正常时无需校正。点击标准按键右侧的按钮，松开手柄按键，再按对应实体键；10 秒未输入会取消。校正不会改变上方游戏动作分配。" Foreground="#BFB5C2" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl Name="DualSenseCalibrationMappings" />
            <Button Content="复位默认实体按键" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetCalibration_OnClick" />
          </StackPanel>
        </Expander>
      </StackPanel>
      <Separator Margin="0,16" />
      <TextBlock Text="公共按键" FontSize="17" FontWeight="Bold" Margin="3,0,0,8" />
      <TextBlock Text="键盘绑定：点击按键框，再按想使用的单个按键（或鼠标键）；Esc 取消，右键菜单可清除绑定。" TextWrapping="Wrap" Foreground="#BFB5C2" Margin="3,0,0,8" />
      <ItemsControl Name="CommonMappings" />
      <WrapPanel Margin="0,16,0,8">
        <Button Content="恢复默认映射" Click="Defaults_OnClick" />
        <Button Content="保存控制设置" Background="#5A1D50" BorderBrush="#A85B9B" Click="Save_OnClick" />
      </WrapPanel>
      <TextBlock Name="StatusText" TextWrapping="Wrap" Foreground="#E7C56A" />
    </StackPanel>
  </ScrollViewer>
</UserControl>