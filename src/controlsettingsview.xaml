<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ControlSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Text="Controls" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
      <WrapPanel>
        <TextBlock Text="Input Method" VerticalAlignment="Center" Margin="3,0,12,0" />
        <ComboBox Name="InputModeSelector" Width="250" SelectedIndex="0" SelectionChanged="InputMode_OnChanged">
          <ComboBoxItem Content="Keyboard and Mouse" Tag="keyboard" />
          <ComboBoxItem Content="XInput Controller" Tag="xinput" />
          <ComboBoxItem Content="DualSense (PS5, native)" Tag="xinput" />
        </ComboBox>
      </WrapPanel>
      <TextBlock Text="The left mouse button acts as the touch screen. The shared keyboard buttons work with every input method. Saved settings take effect the next time the game starts." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="3,8,0,16" />
      <StackPanel Name="KeyboardPanel">
        <TextBlock Text="Keyboard and Mouse Mapping" FontSize="17" FontWeight="Bold" Margin="3,0,0,8" />
        <ItemsControl Name="KeyboardMappings" MaxWidth="500" HorizontalAlignment="Stretch" />
      </StackPanel>
      <StackPanel Name="ControllerPanel" Visibility="Collapsed">
        <TextBlock Name="ControllerMappingTitle" Text="XInput Controller Mapping" TextAlignment="Center" FontSize="17" FontWeight="Bold" Margin="3,0,0,8" />
        <TextBlock Name="DualSenseHelp" Visibility="Collapsed" Text="Plug in a DualSense or DualSense Edge over USB or Bluetooth, save PS5 mode, then click Detect Controller. If DS4Windows or Steam Input already turns the pad into an Xbox controller, pick XInput instead so every press is not counted twice." Foreground="#BFB5C2" TextWrapping="Wrap" Margin="3,0,0,12" />
        <ItemsControl Name="ControllerMappings" MaxWidth="500" HorizontalAlignment="Stretch">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                <Setter Property="TextBlock.TextAlignment" Value="Center" />
              </Style>
              <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
        </ItemsControl>
        <WrapPanel Margin="0,8">
          <TextBlock Text="Movement" VerticalAlignment="Center" Margin="3,0,8,0" />
          <ComboBox Name="MovementSelector" Width="130" SelectedIndex="0">
            <ComboBoxItem Content="Left Stick" />
            <ComboBoxItem Content="Right Stick" />
            <ComboBoxItem Content="D-Pad" />
          </ComboBox>
          <TextBlock Text="Controller Number" VerticalAlignment="Center" Margin="12,0,8,0" />
          <ComboBox Name="ControllerSelector" Width="65" SelectedIndex="0">
            <ComboBoxItem Content="1" />
            <ComboBoxItem Content="2" />
            <ComboBoxItem Content="3" />
            <ComboBoxItem Content="4" />
          </ComboBox>
          <TextBlock Text="Stick Deadzone" VerticalAlignment="Center" Margin="12,0,8,0" />
          <TextBox Name="DeadzoneInput" Width="90" Text="7849" TextAlignment="Center" VerticalContentAlignment="Center" Foreground="#FFFFFFFF" Background="#18131B" CaretBrush="#FFFFFFFF" />
        </WrapPanel>
        <TextBlock Name="ControllerDeadzoneHelp" Text="Deadzone range is 0-32766, default 7849. LT / RT press threshold is 64; menus still use the mouse or touch screen." Foreground="#BFB5C2" TextWrapping="Wrap" Margin="3,0,0,12" />
        <CheckBox Name="RumbleEnabled" Content="Enable controller rumble (attacking, landing hits, taking hits)" Foreground="#FFFFFFFF" Margin="3,8" />
        <WrapPanel Margin="3,4,0,8">
          <TextBlock Text="Rumble Strength" VerticalAlignment="Center" Margin="0,0,10,0" />
          <Slider Name="RumbleStrength" Minimum="0" Maximum="100" Value="70" TickFrequency="1" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center" />
          <TextBlock Width="55" Margin="10,0" VerticalAlignment="Center" Text="{Binding ElementName=RumbleStrength, Path=Value, StringFormat={}{0:0}%}" />
          <Button Name="RumbleTestButton" Content="Test Rumble" Click="RumbleTest_OnClick" />
          <Button Content="Detect Controller" Click="DetectController_OnClick" />
        </WrapPanel>
        <TextBlock Text="Attack Strength (multiplied by the overall strength above)" FontWeight="Bold" Margin="3,8" />
        <ItemsControl Name="CardRumbleSettings" />
        <TextBlock Text="Attack rumble follows the attack animation and stops when the attack ends or is interrupted; hits landed and taken add a short extra pulse. It uses the controller selected above, and stops when you switch away from the game or enter photo mode." Foreground="#BFB5C2" TextWrapping="Wrap" Margin="3,0,0,12" />
        <Expander Name="DualSenseCalibrationPanel" Header="DualSense Button Calibration" Foreground="#FFFFFFFF" Visibility="Collapsed" Margin="3,12,0,8">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Text="You only need this if a button is read as the wrong one. Click the button beside a standard name, release everything on the controller, then press the physical button you want; it cancels after 10 seconds with no input. Calibration does not change the game actions assigned above." Foreground="#BFB5C2" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl Name="DualSenseCalibrationMappings" />
            <Button Content="Reset to Default Buttons" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetCalibration_OnClick" />
          </StackPanel>
        </Expander>
      </StackPanel>
      <Separator Margin="0,16" />
      <TextBlock Text="Shared Buttons" FontSize="17" FontWeight="Bold" Margin="3,0,0,8" />
      <TextBlock Text="Keyboard binding: click a button box, then press the single key or mouse button you want. Esc cancels, and the right-click menu clears a binding." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="3,0,0,8" />
      <ItemsControl Name="CommonMappings" />
      <WrapPanel Margin="0,16,0,8">
        <Button Content="Restore Defaults" Click="Defaults_OnClick" />
        <Button Content="Save" Background="#5A1D50" BorderBrush="#A85B9B" Click="Save_OnClick" />
      </WrapPanel>
      <TextBlock Name="StatusText" TextWrapping="Wrap" Foreground="#E7C56A" />
    </StackPanel>
  </ScrollViewer>
</UserControl>