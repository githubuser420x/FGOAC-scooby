<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.CursorSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <StackPanel Margin="3,12">
    <TextBlock Text="鼠标指针与反色描边" Foreground="#F5F1F6" FontWeight="Bold" Margin="0,0,0,10" />
    <TextBlock Text="更换游戏中的十字指针。设置单独保存，下次启动游戏生效。" Foreground="#BFB5C2" TextWrapping="Wrap" />
    <WrapPanel Margin="0,8">
      <ComboBox Name="Mode" Width="170" SelectedIndex="0" SelectionChanged="Settings_OnChanged">
        <ComboBoxItem Content="默认十字" />
        <ComboBoxItem Content="系统箭头" />
        <ComboBoxItem Content="自定义图片" />
      </ComboBox>
      <Button Content="选择图片…" Margin="8,0" Click="Choose_OnClick" />
    </WrapPanel>
    <TextBlock Name="ImageName" Text="支持透明 PNG、JPG、BMP。图片会保存到游戏目录，移动安装位置仍可使用。" TextWrapping="Wrap" Foreground="#BFB5C2" />
    <Grid Margin="0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="132" Height="132" Background="#26202D" BorderBrush="#8A6A98" BorderThickness="1" VerticalAlignment="Top">
        <Grid>
          <Image Name="Preview" Stretch="None" />
          <Canvas IsHitTestVisible="False">
            <Ellipse Name="Hotspot" Width="5" Height="5" Fill="#FF66B8" Stroke="#FFFFFFFF" StrokeThickness="1" />
          </Canvas>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Foreground="#EDE7EF" Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat=大小：{0:0} 像素}" />
        <Slider Name="SizeSlider" Minimum="16" Maximum="128" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Settings_OnChanged" />
        <TextBlock Foreground="#EDE7EF" Text="{Binding ElementName=OutlineSlider, Path=Value, StringFormat=反色描边：{0:0} 像素（0 为关闭）}" />
        <Slider Name="OutlineSlider" Minimum="0" Maximum="6" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Settings_OnChanged" />
        <TextBlock Foreground="#BFB5C2" Text="描边实时反转其下方画面的颜色。预览使用暗色格子；指针本体保留图片颜色，透明区域按轮廓裁切。" TextWrapping="Wrap" Margin="0,8" />
      </StackPanel>
    </Grid>
    <TextBlock Text="粉色点标出实际点击位置。热点以指针画布百分比设置，中心为 50%，左上角为 0%。" Foreground="#BFB5C2" TextWrapping="Wrap" />
    <TextBlock Foreground="#EDE7EF" Text="{Binding ElementName=HotX, Path=Value, StringFormat=热点 X：{0:0}%}" />
    <Slider Name="HotX" Minimum="0" Maximum="100" Value="50" ValueChanged="Settings_OnChanged" />
    <TextBlock Foreground="#EDE7EF" Text="{Binding ElementName=HotY, Path=Value, StringFormat=热点 Y：{0:0}%}" />
    <Slider Name="HotY" Minimum="0" Maximum="100" Value="50" ValueChanged="Settings_OnChanged" />
    <Button Content="保存指针设置" HorizontalAlignment="Left" Margin="0,8" Click="Save_OnClick" />
    <TextBlock Name="Status" Foreground="#E7C56A" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>