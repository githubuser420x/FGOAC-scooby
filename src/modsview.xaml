<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ModsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform">
  <UserControl.Resources>
    <Style x:Key="ModRowTemplate" TargetType="{x:Type ListViewItem}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <DataTemplate x:Key="ModRowContent" DataType="{x:Type local:ModRow}">
      <Grid Margin="8,6" MinHeight="52">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay}" Checked="ModCheck_OnChanged" Unchecked="ModCheck_OnChanged" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,14,0">
          <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding Folder}" FontFamily="{StaticResource DigitFont}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
            <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextFaintBrush}" />
            <TextBlock Text="{Binding FilesLabel}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
            <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextFaintBrush}" />
            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="2" BorderThickness="1" Padding="10,4" MinWidth="92" CornerRadius="2">
          <Border.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Background" Value="{StaticResource PlateBrush}" />
              <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Applied}" Value="True">
                  <Setter Property="Background" Value="{StaticResource IceDeepBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource IceBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Applied}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource IceBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <TabControl>
    <TabItem Header="Mods">
      <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="180" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
          <TextBlock Text="Mods" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,6,0,0" Text="Mods change the game and the local server. The original of every file a mod touches is stored first, so a mod comes off again exactly as it went on, and an update that overwrites a file can be put back. Tick what you want, then Apply Selected. The game and the server must be closed." />
          <TextBlock Name="ModSummaryText" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource TextSoftBrush}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
          <Button Content="Apply Selected" MinWidth="140" Margin="0,0,8,8" Click="Apply_OnClick" />
          <Button Content="Remove Selected" MinWidth="150" Margin="0,0,8,8" Click="Remove_OnClick" />
          <Button Content="Apply All" MinWidth="110" Margin="0,0,8,8" Click="ApplyAll_OnClick" />
          <Button Content="Remove All" MinWidth="110" Margin="0,0,8,8" Click="RemoveAll_OnClick" />
          <Button Content="Restore Everything" MinWidth="164" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,8" ToolTip="Put every managed file back to the original and clear the journal." Click="Restore_OnClick" />
          <Button Content="Verify" MinWidth="92" Margin="0,0,8,8" ToolTip="Report any managed file that no longer matches the journal." Click="Verify_OnClick" />
          <Button Content="Repair" MinWidth="92" Margin="0,0,8,8" ToolTip="Re-apply the intended state to any file that drifted." Click="Repair_OnClick" />
          <Button Content="Refresh" MinWidth="92" Margin="0,0,8,8" Click="Refresh_OnClick" />
          <Button Content="Import Mod..." MinWidth="132" Margin="0,0,8,8" ToolTip="Add a mod from a .zip. The archive must hold a folder with a mod.json in it." Click="Import_OnClick" />
          <Button Content="Open Mods Folder" MinWidth="164" Margin="0,0,8,8" ToolTip="Show the Mods folder. Drop a mod folder in it, then press Refresh." Click="OpenFolder_OnClick" />
        </WrapPanel>
        <ListView Name="ModList" Grid.Row="2" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemTemplate="{StaticResource ModRowContent}" ItemContainerStyle="{StaticResource ModRowTemplate}" SelectionChanged="ModList_OnSelectionChanged" />
        <Border Grid.Row="3" BorderThickness="1" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" Margin="0,12,0,0" Padding="12">
          <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="DetailText" TextWrapping="Wrap" Foreground="{StaticResource TextSoftBrush}" />
          </ScrollViewer>
        </Border>
        <TextBlock Name="StatusText" Grid.Row="4" Style="{StaticResource HelpTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
      </Grid>
    </TabItem>
    <TabItem Header="Battle Tuner">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" MaxWidth="1000" HorizontalAlignment="Left">
          <TextBlock Text="Battle Tuner" Style="{StaticResource SectionTitleStyle}" />
          <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,6,0,16" Text="The numbers behind a battle: the wave countdown, skill cooldown, Noble Phantasm gain, the quantity of enemy drops and the bond a quest pays out. Every number that means 'leave it alone' is 1. The game and the server must be closed while a change is written." />
          <Border BorderThickness="1" Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" Padding="14" Margin="0,0,0,20">
            <TextBlock Name="TunerStateText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
          </Border>
          <StackPanel Name="TunerPanel" />
          <WrapPanel Margin="0,8,0,12">
            <Button Name="TunerApplyButton" Content="Save &amp; Apply" MinWidth="150" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" ToolTip="Store these numbers and write them into the game files" Click="TunerApply_OnClick" />
            <Button Name="TunerResetButton" Content="Restore Defaults" MinWidth="150" Margin="0,0,8,0" ToolTip="Put the bundled defaults back in the fields. Nothing is written until you press Save and Apply." Click="TunerReset_OnClick" />
          </WrapPanel>
          <TextBlock Name="BattleStatusText" Style="{StaticResource HelpTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>