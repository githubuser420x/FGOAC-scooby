<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.SummonSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <Grid Margin="28,20,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Servants and Craft Essences share one set of draw rates" Style="{StaticResource SectionTitleStyle}" />
      <TextBlock Margin="0,8,0,12" Style="{StaticResource HelpTextStyle}" Text="Regular and supplemental cards share one local draw table; story-fixed cards are held out of it. Weight divided by total weight is the draw chance, and 0 means the card is never drawn. There is no hidden rate-up and no ten-pull pity." />
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="Search name / number" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSoftBrush}" />
      <ComboBox Name="CategoryFilter" DockPanel.Dock="Right" Width="265" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_OnChanged">
        <ComboBoxItem Content="Regular + Supplemental (drawable)" />
        <ComboBoxItem Content="Regular Summon" />
        <ComboBoxItem Content="Supplemental" />
        <ComboBoxItem Content="Story (fixed, read-only)" />
      </ComboBox>
      <ComboBox Name="KindFilter" DockPanel.Dock="Right" Width="125" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_OnChanged">
        <ComboBoxItem Content="All Types" />
        <ComboBoxItem Content="Servant" />
        <ComboBoxItem Content="Craft Essence" />
      </ComboBox>
      <TextBox Name="SearchBox" ToolTip="Search the Japanese name, English name, file number, full file name or card ID" TextChanged="Search_OnChanged" />
    </DockPanel>
    <WrapPanel Name="EditButtons" Grid.Row="2">
      <Button Content="Even for All" Click="EqualAll_OnClick" />
      <Button Content="Only Selected (100%)" Click="OnlyOne_OnClick" />
      <Button Content="Even for Selected" Click="EqualSelected_OnClick" />
      <Button Content="Exclude Selected" Click="Exclude_OnClick" />
      <TextBlock Text="Ctrl / Shift selects more than one" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" Margin="8,0,0,6" />
    </WrapPanel>
    <DataGrid Name="CardsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow" MinRowHeight="112" HeadersVisibility="Column" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" CellEditEnding="Grid_OnCellEditEnding" BeginningEdit="Grid_OnBeginningEdit" SelectionChanged="Grid_OnSelectionChanged">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
          </Style>
          <Style x:Key="WrappedCell" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,4" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Card" Width="84" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image Height="90" Width="68" Margin="3" Stretch="Uniform" Source="{Binding Icon}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Name / Internal ID" Width="*" MinWidth="190" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding EnglishName}" ToolTip="{Binding AcquisitionNote}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryNameStyle}" Margin="6,4" Text="{Binding JapaneseName}" />
                <TextBlock Foreground="{StaticResource TextSoftBrush}" Margin="6,5,6,0" Text="{Binding FileNumber}" ToolTip="{Binding FileName}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Category" Width="100" MaxWidth="140" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding CategoryName}" />
        <DataGridTextColumn Header="Type / Card" Width="112" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding KindName}" />
        <DataGridTextColumn Header="Rarity" Width="65" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding Stars}" />
        <DataGridTextColumn Header="Card ID" Width="85" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding TcId}" />
        <DataGridTextColumn Header="Weight (integer)" Width="158" ElementStyle="{StaticResource WrappedCell}" Binding="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" />
        <DataGridTextColumn Header="Draw Chance" Width="120" ElementStyle="{StaticResource WrappedCell}" IsReadOnly="True" Binding="{Binding Probability}" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,12,0,8">
      <TextBlock Name="SummaryText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
      <TextBlock Name="StatusText" Margin="0,6,0,0" Style="{StaticResource HelpTextStyle}" />
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,6,0,0" Foreground="{StaticResource TextFaintBrush}" Text="Supplemental covers cards that come from local rewards, Bond and the like rather than a regular summon, and keeps one base card art for each. Story and first-clear cards are listed separately and stay out of the random pool. Normal and Fatal summon tickets draw only from the card arts each one supports, using these same weights; fixed exchanges are unaffected." />
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Reload" Height="36" Margin="3" VerticalAlignment="Center" Click="Reload_OnClick" />
      <Button Name="SaveButton" Content="Save · Applies to the Next Draw" Height="36" Margin="3" VerticalAlignment="Center" Click="Save_OnClick" />
    </StackPanel>
  </Grid>
</UserControl>