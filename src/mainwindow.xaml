<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:kancolle="clr-namespace:DeckReaderUI.Kancolle" xmlns:local="clr-namespace:FGOLocalPlatform" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="" Icon="AprilFoolFGOFirstHassan.ico" Width="1540" Height="900" MinWidth="1180" MinHeight="720" WindowStyle="None" ResizeMode="CanResize" Background="#050506" Foreground="#FFFFFFFF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Closing="MainWindow_OnClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="CardFormMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" />
      <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="31" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="#DCD5DF" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="CaptionSurface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="CaptionSurface" Property="Border.Background" Value="#251B27" />
                  <Setter TargetName="CaptionSurface" Property="Border.BorderBrush" Value="#C764B3" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CaptionSurface" Property="Border.Background" Value="#4A1D46" />
                  <Setter TargetName="CaptionSurface" Property="Border.BorderBrush" Value="#F08ADA" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Foreground" Value="#DCD5DF" />
      </Style>
      <Style x:Key="PanelSplitterStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="#151119" />
        <Setter Property="GridSplitter.ShowsPreview" Value="True" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GridSplitter}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Border Name="Grip" Background="#4A1D46" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Width="2" Height="30" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Border.Background" Value="#B45A9F" />
                  <Setter TargetName="Grip" Property="UIElement.Opacity" Value="1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HorizontalPanelSplitterStyle" TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource PanelSplitterStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GridSplitter}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Border Name="Grip" Background="#4A1D46" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Border.Background" Value="#B45A9F" />
                  <Setter TargetName="Grip" Property="UIElement.Opacity" Value="1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="CardIconRowTemplate">
        <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Type local:CardStack}}" DataType="{x:Type local:CardStack}">
              <Button Width="144" Height="188" Margin="0" Padding="0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="IconCardButton_OnClick" MouseDoubleClick="IconCardButton_OnMouseDoubleClick">
                <Grid Margin="2" Width="140" Height="184">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="126" />
                    <RowDefinition Height="58" />
                  </Grid.RowDefinitions>
                  <Border Background="#050506" BorderBrush="#493E4F" BorderThickness="1" Padding="3">
                    <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail}" />
                  </Border>
                  <Border Grid.Row="1" Background="#E8121016" BorderBrush="#6B245E" BorderThickness="1,0,1,1" Padding="5,2">
                    <StackPanel VerticalAlignment="Center">
                      <Viewbox Height="17" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock TextAlignment="Center" Foreground="#FFFFFFFF" FontSize="11" Text="{Binding JapaneseName}" />
                      </Viewbox>
                      <Viewbox Height="17" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock TextAlignment="Center" Foreground="#D7BBDD" FontSize="11" ToolTip="中文参考译名，含机器翻译" Text="{Binding ChineseName}" />
                      </Viewbox>
                      <Viewbox Height="16" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock TextAlignment="Center" Foreground="#BFB5C2" FontSize="10" Text="{Binding EntityLabel}" />
                      </Viewbox>
                    </StackPanel>
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#050506" BorderBrush="#29232D" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
        <RowDefinition Height="38" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#0C0A0E" BorderBrush="#2C2530" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Image Source="AprilFoolFGOFirstHassan.ico" Width="18" Height="18" Margin="0,0,8,0" />
            <TextBlock Name="HeaderBrandText" Foreground="#B9B0BC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="最小化" Click="MinimizeButton_OnClick">
              <Path Width="12" Height="12" Stretch="None" Data="M1,8 L11,8" StrokeThickness="1.5" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="最大化 / 还原" Click="MaximizeButton_OnClick">
              <Rectangle Width="10" Height="10" StrokeThickness="1.25" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="关闭" Click="CloseButton_OnClick">
              <Path Width="12" Height="12" Stretch="None" Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="#050506" BorderBrush="#34283A" BorderThickness="0,0,0,1">
        <Grid ClipToBounds="True">
          <Canvas IsHitTestVisible="False">
            <Polygon Points="0,0 350,0 320,72 0,72" Fill="#F4F1F5" />
          </Canvas>
          <Grid Margin="24,0,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="FGO" FontSize="30" FontWeight="Black" Foreground="#080709" />
                <TextBlock Text=" / LOCAL" FontSize="18" FontWeight="Light" Foreground="#6B245E" Margin="8,9,0,0" />
              </StackPanel>
              <TextBlock Text="ARCADE 11.00 · DECK / SERVER / DISPLAY" Foreground="#413843" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
            <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
              <ToggleButton Name="ChineseEnabledCheckBox" VerticalAlignment="Stretch" Margin="3,3,10,3" MinWidth="110" ToolTip="点击开启或关闭中文；下次启动游戏生效。">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Content" Value="使用中文 · 关" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Background" Value="#17131B" />
                    <Setter Property="BorderBrush" Value="#3E3343" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="ToggleButton.IsChecked" Value="True">
                        <Setter Property="Content" Value="使用中文 · 开" />
                        <Setter Property="Background" Value="#5A1D50" />
                        <Setter Property="BorderBrush" Value="#A85B9B" />
                      </Trigger>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#ED9BDC" />
                      </Trigger>
                      <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#ED9BDC" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#78336C" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ToggleButton>
              <UniformGrid Rows="1">
                <Button Content="服务器启动 / 检查" Click="StartServerButton_OnClick" />
                <Button Content="服务器停止" Click="StopServerButton_OnClick" />
                <Button Content="日志目录" Click="OpenLogsButton_OnClick" />
                <Button Name="StopGameButton" Content="停止游戏" IsEnabled="False" Background="#35141E" BorderBrush="#713044" Click="StopGameButton_OnClick" />
                <Button Name="StartGameButton" Content="启动游戏" FontSize="15" Background="#5A1D50" BorderBrush="#A85B9B" Click="StartGameButton_OnClick" />
              </UniformGrid>
            </DockPanel>
          </Grid>
        </Grid>
      </Border>
      <Grid Row="2" Margin="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Name="WorkspaceColumn" Width="*" MinWidth="650" />
          <ColumnDefinition Name="LogSplitterColumn" Width="7" />
          <ColumnDefinition Name="LogPanelColumn" Width="440" MinWidth="310" />
        </Grid.ColumnDefinitions>
        <TabControl Grid.Column="0" Background="#101014" BorderBrush="#403545">
          <TabItem Header="卡组">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Name="SettingsPanelRow" Height="52" MinHeight="48" />
                <RowDefinition Height="7" />
                <RowDefinition Name="CardBrowserRow" Height="*" MinHeight="240" />
                <RowDefinition Height="7" />
                <RowDefinition Name="DeckPanelRow" Height="195" MinHeight="195" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#403545" BorderThickness="1">
                <Grid Margin="8">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="卡片目录" Foreground="#A84F96" VerticalAlignment="Center" Margin="3" FontWeight="Bold" />
                  <TextBox Name="CardsPathTextBox" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" KeyDown="CardsPathTextBox_OnKeyDown" />
                  <Button Grid.Row="0" Grid.Column="2" Content="载入" ToolTip="重新读取卡片目录" Click="ReloadButton_OnClick" />
                </Grid>
              </Border>
              <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalPanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
              <Grid Row="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Name="CardListColumn" Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Background="#18131B" BorderBrush="#4A1D46" BorderThickness="1" Padding="7,3">
                  <StackPanel>
                    <DockPanel Margin="4,3,4,7" LastChildFill="False">
                      <TextBlock Text="选择从者 / 礼装 · 双击选择卡片类型与数量" Foreground="#B45A9F" FontWeight="Bold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel LastChildFill="True">
                      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="种类" Foreground="#BFB5C2" VerticalAlignment="Center" />
                        <ComboBox Name="CardTypeComboBox" Width="120" SelectedIndex="0" ToolTip="将从者卡和概念礼装卡分开显示">
                          <ComboBoxItem Content="全部卡片" Tag="0" />
                          <ComboBoxItem Content="从者卡" Tag="1" />
                          <ComboBoxItem Content="概念礼装" Tag="2" />
                        </ComboBox>
                        <ToggleButton Name="OwnedCardsOnlyCheckBox" IsEnabled="False" VerticalAlignment="Center" Margin="8,3,3,3" ToolTip="仅显示本账号已打印入库的卡片，不包含待打印结果。" Checked="OwnedCardsOnlyCheckBox_OnChanged" Unchecked="OwnedCardsOnlyCheckBox_OnChanged">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type ToggleButton}">
                              <Setter Property="Content" Value="仅本账号已入库 · 关" />
                              <Setter Property="Foreground" Value="#FFFFFFFF" />
                              <Setter Property="Background" Value="#17131B" />
                              <Setter Property="BorderBrush" Value="#3E3343" />
                              <Setter Property="Padding" Value="9,3" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Control.Padding}">
                                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                  <Setter Property="Content" Value="仅本账号已入库 · 开" />
                                  <Setter Property="Background" Value="#5A1D50" />
                                  <Setter Property="BorderBrush" Value="#A85B9B" />
                                </Trigger>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter Property="BorderBrush" Value="#ED9BDC" />
                                </Trigger>
                                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                                  <Setter Property="BorderBrush" Value="#ED9BDC" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                  <Setter Property="Background" Value="#78336C" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter Property="UIElement.Opacity" Value="0.5" />
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </ToggleButton>
                      </StackPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Name="BuildThumbnailCacheButton" Content="缓存缩略图" Padding="9,3" ToolTip="在 DEVICE/cache/card-thumbnails 生成本地 JPEG 缩略图缓存" Click="BuildThumbnailCacheButton_OnClick" />
                        <TextBlock Text="视图" Foreground="#BFB5C2" VerticalAlignment="Center" Margin="7,0,2,0" />
                        <Button Name="ListViewModeButton" Content="列表" Padding="9,3" Click="ListViewModeButton_OnClick" />
                        <Button Name="IconViewModeButton" Content="图标" Padding="9,3" Click="IconViewModeButton_OnClick" />
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Name="CardCatalogSummaryText" Text="卡库读取中…" Margin="4,3" Foreground="#D7BBDD" TextTrimming="CharacterEllipsis" />
                    <DockPanel Margin="0,4,0,0">
                      <TextBlock Text="搜索卡片" VerticalAlignment="Center" Margin="4,0,10,0" Foreground="#BFB5C2" />
                      <TextBox Name="SearchTextBox" VerticalContentAlignment="Center" ToolTip="输入卡名、编号或文件名即时筛选；清空恢复全部结果" TextChanged="CardPickerSearchBox_OnTextChanged" />
                    </DockPanel>
                  </StackPanel>
                </Border>
                <ListView Name="CardList" Grid.Row="1" Grid.Column="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="CardList_OnSelectionChanged" MouseDoubleClick="CardList_OnMouseDoubleClick">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:CardStack}">
                      <Grid Margin="3" MinHeight="104">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="66" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#050506" BorderBrush="#493E4F" BorderThickness="1" Padding="2">
                          <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                          <TextBlock Foreground="#FFFFFFFF" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding JapaneseName}" />
                          <TextBlock Foreground="#D7BBDD" TextWrapping="Wrap" ToolTip="中文参考译名，含机器翻译" Text="{Binding ChineseName}" />
                          <TextBlock Foreground="#BFB5C2" FontSize="11" Margin="0,4,0,0" Text="{Binding EntityLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8">
                          <Border Background="#351832" BorderBrush="#8A2E78" BorderThickness="1" Padding="8,3">
                            <TextBlock Foreground="#F2C8EA" FontSize="11" Text="{Binding StackLabel}" />
                          </Border>
                          <TextBlock Foreground="#A84F96" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right" Margin="0,7,0,0" Text="{Binding TrcId, StringFormat=TC ID {0}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ListView>
              </Grid>
              <GridSplitter Grid.Row="3" Style="{StaticResource HorizontalPanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
              <Border Grid.Row="4" Background="#0A090C" BorderBrush="#403545" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <DockPanel Background="#18131B">
                    <TextBlock Name="DeckStatusText" DockPanel.Dock="Left" Foreground="#B45A9F" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                    <Button DockPanel.Dock="Right" Content="清空卡组" Padding="10,3" Click="ClearButton_OnClick" />
                  </DockPanel>
                  <ListView Name="SelectedCardList" Grid.Row="1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="SelectedCardList_OnSelectionChanged" MouseDoubleClick="SelectedCardList_OnMouseDoubleClick">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:CardStack}">
                        <Grid Margin="4" Width="88" Height="142">
                          <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail}" />
                          <Border VerticalAlignment="Bottom" Background="#EA17121A" Padding="3">
                            <StackPanel>
                              <Viewbox Height="14" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock TextAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" Text="{Binding JapaneseName}" />
                              </Viewbox>
                              <Viewbox Height="14" Stretch="Uniform" StretchDirection="DownOnly">
                                <TextBlock TextAlignment="Center" Foreground="#D7BBDD" FontSize="10" Text="{Binding ChineseName}" />
                              </Viewbox>
                              <TextBlock TextAlignment="Center" Foreground="#F2C8EA" FontSize="10" Text="{Binding Count, StringFormat=×{0}}" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ListView>
                </Grid>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="账号">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16">
                <TextBlock Text="本地账号" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
                <WrapPanel Margin="0,0,0,16" VerticalAlignment="Center">
                  <TextBlock Text="ACCOUNT / 本地账号" Foreground="#A84F96" VerticalAlignment="Center" Margin="3" FontWeight="Bold" />
                  <TextBlock Text="当前" VerticalAlignment="Center" Margin="10,3,3,3" Foreground="#BFB5C2" />
                  <TextBlock Name="CurrentAccountText" Text="读取中…" Foreground="#F5F1F6" VerticalAlignment="Center" Margin="3" />
                  <TextBlock Text="卡码" VerticalAlignment="Center" Margin="10,3,3,3" Foreground="#BFB5C2" />
                  <TextBlock Name="CurrentAccessCodeText" Text="—" Foreground="#9CF6C8" VerticalAlignment="Center" Margin="3" FontFamily="Cascadia Mono, Consolas" />
                  <TextBlock Text="选择" VerticalAlignment="Center" Margin="10,3,3,3" Foreground="#BFB5C2" />
                  <ComboBox Name="AccountComboBox" Width="270" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ToolTip="本地账号列表（MASTER 名 · Aime ID · 账号模式）" SelectionChanged="AccountComboBox_OnSelectionChanged" />
                  <Button Name="UseAccountButton" Content="使用选中账号" Click="UseAccountButton_OnClick" />
                  <Button Name="CreateAccountButton" Content="新建账号" Click="CreateAccountButton_OnClick" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,16">
                  <Button Name="ResetAccountButton" Content="重置为普通新账号" Background="#35141E" BorderBrush="#713044" Click="ResetAccountButton_OnClick" />
                  <Button Name="DeleteAccountButton" Content="删除账号" IsEnabled="False" Background="#45141B" BorderBrush="#A43B4A" ToolTip="永久删除选中账号的存档、Aime 身份、卡映射及账号备份残留" Click="DeleteAccountButton_OnClick" />
