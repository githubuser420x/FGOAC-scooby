              </Grid.RowDefinitions>
              <Border Background="#1A111B" BorderBrush="#4A1D46" BorderThickness="0,0,0,1">
                <DockPanel Margin="10,0" LastChildFill="False">
                  <TextBlock Text="SERVER / 本地服务器日志" FontWeight="Bold" Foreground="#B45A9F" VerticalAlignment="Center" />
