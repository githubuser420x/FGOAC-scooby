                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="Margin" Value="3,3,9,9" />
                      </Style>
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                  <Button Content="全角色打印入库" Tag="servants" ToolTip="按正式获取流程将每种从者卡片补足 5 张；已有超过 5 张的保留，重复执行不累加" Click="AccountUpgrade_OnClick" />
                  <Button Content="全概念礼装打印入库" Tag="craft-essences" ToolTip="将每种概念礼装卡片补足 5 张；已有超过 5 张的保留，重复执行不累加" Click="AccountUpgrade_OnClick" />
                  <Button Content="一键清空礼物箱" Tag="clear-gifts" ToolTip="删除选中账号的全部未领取礼物，不领取奖励；保留领取和删除历史，操作前自动备份" Click="AccountUpgrade_OnClick" />
