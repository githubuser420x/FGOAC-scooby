<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:kancolle="clr-namespace:DeckReaderUI.Kancolle" xmlns:local="clr-namespace:FGOLocalPlatform" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="" Icon="AprilFoolFGOFirstHassan.ico" Width="1540" Height="900" MinWidth="1180" MinHeight="720" WindowStyle="None" ResizeMode="CanResize" Background="#050506" Foreground="#FFFFFFFF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Closing="MainWindow_OnClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="CardFormMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}" />
      <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="31" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="#DCD5DF" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="CaptionSurface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="CaptionSurface" Property="Border.Background" Value="#251B27" />
                  <Setter TargetName="CaptionSurface" Property="Border.BorderBrush" Value="#C764B3" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="CaptionSurface" Property="Border.Background" Value="#4A1D46" />
                  <Setter TargetName="CaptionSurface" Property="Border.BorderBrush" Value="#F08ADA" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Foreground" Value="#DCD5DF" />
      </Style>
      <Style x:Key="PanelSplitterStyle" TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="#151119" />
        <Setter Property="GridSplitter.ShowsPreview" Value="True" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GridSplitter}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Border Name="Grip" Background="#4A1D46" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Width="2" Height="30" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Border.Background" Value="#B45A9F" />
                  <Setter TargetName="Grip" Property="UIElement.Opacity" Value="1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HorizontalPanelSplitterStyle" TargetType="{x:Type GridSplitter}" BasedOn="{StaticResource PanelSplitterStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GridSplitter}">
              <Grid Background="{TemplateBinding Control.Background}">
                <Border Name="Grip" Background="#4A1D46" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="2" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Border.Background" Value="#B45A9F" />
                  <Setter TargetName="Grip" Property="UIElement.Opacity" Value="1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="CardIconRowTemplate">
        <ItemsControl HorizontalAlignment="Left" ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:Key="{DataTemplateKey {x:Type local:CardStack}}" DataType="{x:Type local:CardStack}">
              <Button Width="144" Height="188" Margin="0" Padding="0" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="IconCardButton_OnClick" MouseDoubleClick="IconCardButton_OnMouseDoubleClick">
                <Grid Margin="2" Width="140" Height="184">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="126" />
                    <RowDefinition Height="58" />
                  </Grid.RowDefinitions>
                  <Border Background="#050506" BorderBrush="#493E4F" BorderThickness="1" Padding="3">
                    <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail}" />
                  </Border>
                  <Border Grid.Row="1" Background="#E8121016" BorderBrush="#6B245E" BorderThickness="1,0,1,1" Padding="5,2">
                    <StackPanel VerticalAlignment="Center">
                      <Viewbox Height="17" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock TextAlignment="Center" Foreground="#FFFFFFFF" FontSize="11" Text="{Binding JapaneseName}" />
                      </Viewbox>
                      <Viewbox Height="17" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock TextAlignment="Center" Foreground="#D7BBDD" FontSize="11" ToolTip="English name, from the official FGO NA name list where a match exists" Text="{Binding ChineseName}" />
                      </Viewbox>
                      <Viewbox Height="16" Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock TextAlignment="Center" Foreground="#BFB5C2" FontSize="10" Text="{Binding EntityLabel}" />
                      </Viewbox>
                    </StackPanel>
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#050506" BorderBrush="#29232D" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
        <RowDefinition Height="38" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#0C0A0E" BorderBrush="#2C2530" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Image Source="AprilFoolFGOFirstHassan.ico" Width="18" Height="18" Margin="0,0,8,0" />
            <TextBlock Name="HeaderBrandText" Foreground="#B9B0BC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="Minimize" Click="MinimizeButton_OnClick">
              <Path Width="12" Height="12" Stretch="None" Data="M1,8 L11,8" StrokeThickness="1.5" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="Maximize / Restore" Click="MaximizeButton_OnClick">
              <Rectangle Width="10" Height="10" StrokeThickness="1.25" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Close" Click="CloseButton_OnClick">
              <Path Width="12" Height="12" Stretch="None" Data="M1.5,1.5 L10.5,10.5 M10.5,1.5 L1.5,10.5" StrokeThickness="1.5" StrokeStartLineCap="Square" StrokeEndLineCap="Square" SnapsToDevicePixels="True" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="#050506" BorderBrush="#34283A" BorderThickness="0,0,0,1">
        <Grid ClipToBounds="True">
          <Canvas IsHitTestVisible="False">
            <Polygon Points="0,0 350,0 320,72 0,72" Fill="#F4F1F5" />
          </Canvas>
          <Grid Margin="24,0,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="FGO" FontSize="30" FontWeight="Black" Foreground="#080709" />
                <TextBlock Text=" / LOCAL" FontSize="18" FontWeight="Light" Foreground="#6B245E" Margin="8,9,0,0" />
              </StackPanel>
              <TextBlock Text="ARCADE 11.00 - DECK / SERVER / DISPLAY" Foreground="#413843" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
            <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
              <ToggleButton Name="ChineseEnabledCheckBox" VerticalAlignment="Stretch" Margin="3,3,10,3" MinWidth="152" ToolTip="Turns the translated in-game text on or off. Takes effect the next time you start the game.">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type ToggleButton}">
                    <Setter Property="Content" Value="English Text - Off" />
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                    <Setter Property="Background" Value="#17131B" />
                    <Setter Property="BorderBrush" Value="#3E3343" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <Trigger Property="ToggleButton.IsChecked" Value="True">
                        <Setter Property="Content" Value="English Text - On" />
                        <Setter Property="Background" Value="#5A1D50" />
                        <Setter Property="BorderBrush" Value="#A85B9B" />
                      </Trigger>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#ED9BDC" />
                      </Trigger>
                      <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#ED9BDC" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#78336C" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </ToggleButton>
              <UniformGrid Rows="1">
                <Button Content="Start Server" ToolTip="Starts the local server. If it is already running, this checks that its ports answer." Click="StartServerButton_OnClick" />
                <Button Content="Stop Server" Click="StopServerButton_OnClick" />
                <Button Content="Open Logs" Click="OpenLogsButton_OnClick" />
                <Button Name="StopGameButton" Content="Stop Game" IsEnabled="False" Background="#35141E" BorderBrush="#713044" Click="StopGameButton_OnClick" />
                <Button Name="StartGameButton" Content="Play" FontSize="15" Background="#5A1D50" BorderBrush="#A85B9B" Click="StartGameButton_OnClick" />
              </UniformGrid>
            </DockPanel>
          </Grid>
        </Grid>
      </Border>
      <Grid Row="2" Margin="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Name="WorkspaceColumn" Width="*" MinWidth="650" />
          <ColumnDefinition Name="LogSplitterColumn" Width="7" />
          <ColumnDefinition Name="LogPanelColumn" Width="440" MinWidth="310" />
        </Grid.ColumnDefinitions>
        <TabControl Grid.Column="0" Background="#101014" BorderBrush="#403545">
          <TabItem Header="Play">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Play" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="The same buttons sit in the bar at the top of the window, so you can start and stop the game from any page." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,20" />
                <WrapPanel Margin="0,0,0,20">
                  <Button Content="Play" FontSize="20" FontWeight="Bold" Padding="56,14" Margin="0,0,12,8" Background="#5A1D50" BorderBrush="#A85B9B" IsEnabled="{Binding IsEnabled, ElementName=StartGameButton}" Click="StartGameButton_OnClick" />
                  <Button Content="Stop Game" Padding="22,14" Margin="0,0,12,8" Background="#35141E" BorderBrush="#713044" IsEnabled="{Binding IsEnabled, ElementName=StopGameButton}" Click="StopGameButton_OnClick" />
                  <Button Content="Start Server" Padding="18,14" Margin="0,0,12,8" ToolTip="Starts the local server. If it is already running, this checks that its ports answer." Click="StartServerButton_OnClick" />
                  <Button Content="Stop Server" Padding="18,14" Margin="0,0,12,8" Click="StopServerButton_OnClick" />
                  <Button Content="Open Logs" Padding="18,14" Margin="0,0,0,8" Click="OpenLogsButton_OnClick" />
                </WrapPanel>
                <Border Background="#18131B" BorderBrush="#4A1D46" BorderThickness="1" Padding="14,10" Margin="0,0,0,24">
                  <StackPanel>
                    <TextBlock Text="STATUS" Foreground="#A84F96" FontWeight="Bold" FontSize="11" Margin="0,0,0,6" />
                    <TextBlock Foreground="#F5F1F6" TextWrapping="Wrap" Text="{Binding Text, ElementName=RuntimeStatusText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <TextBlock Text="Account in use: " Foreground="#BFB5C2" />
                      <TextBlock Foreground="#D7BBDD" TextTrimming="CharacterEllipsis" Text="{Binding Text, ElementName=CurrentAccountText}" />
                    </StackPanel>
                    <TextBlock Foreground="#D7BBDD" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Text, ElementName=DeckStatusText}" />
                  </StackPanel>
                </Border>
                <TextBlock Text="First time here" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock TextWrapping="Wrap" Foreground="#D7BBDD" Margin="0,0,0,7" Text="1. Your account is ready. The first start creates the account Master with the full Servant and Craft Essence roster and selects it, because the in-game summon does not work offline. Account is where you see it, rename the Master, or add another one - the server has to be stopped to create an account." />
                <TextBlock TextWrapping="Wrap" Foreground="#D7BBDD" Margin="0,0,0,7" Text="2. Open Cards and Deck and pick up to 30 cards. The deck is what the cabinet card reader hands to the game, and it is published again every time you press Play." />
                <TextBlock TextWrapping="Wrap" Foreground="#D7BBDD" Margin="0,0,0,7" Text="3. Check Settings for your monitor, resolution and controls. The first start picks windowed 1280x720 on your main monitor with keyboard controls, and never changes a setting you have chosen yourself." />
                <TextBlock TextWrapping="Wrap" Foreground="#D7BBDD" Margin="0,0,0,7" Text="4. Press Play. The server starts by itself if it is not already running, and the game takes about a minute to reach the title screen." />
                <TextBlock TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,14,0,0" Text="The game has to run as administrator, so Windows asks for permission once. If something goes wrong, Advanced has Diagnostics and Help with the error codes and their fixes." />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Account">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="16">
                <TextBlock Text="Local Accounts" FontSize="22" FontWeight="Bold" Margin="0,0,0,16" />
                <WrapPanel Margin="0,0,0,16" VerticalAlignment="Center">
                  <TextBlock Text="ACCOUNT" Foreground="#A84F96" VerticalAlignment="Center" Margin="3" FontWeight="Bold" />
                  <TextBlock Text="In use" VerticalAlignment="Center" Margin="10,3,3,3" Foreground="#BFB5C2" />
                  <TextBlock Name="CurrentAccountText" Text="Loading..." Foreground="#F5F1F6" VerticalAlignment="Center" Margin="3" />
                  <TextBlock Text="Access code" VerticalAlignment="Center" Margin="10,3,3,3" Foreground="#BFB5C2" />
                  <TextBlock Name="CurrentAccessCodeText" Text="—" Foreground="#9CF6C8" VerticalAlignment="Center" Margin="3" FontFamily="Cascadia Mono, Consolas" />
                  <TextBlock Text="Select" VerticalAlignment="Center" Margin="10,3,3,3" Foreground="#BFB5C2" />
                  <ComboBox Name="AccountComboBox" Width="330" VerticalAlignment="Center" DisplayMemberPath="DisplayText" ToolTip="Local accounts (Master name - Aime ID - account mode)" SelectionChanged="AccountComboBox_OnSelectionChanged" />
                  <Button Name="UseAccountButton" Content="Use Selected Account" Click="UseAccountButton_OnClick" />
                  <Button Name="CreateAccountButton" Content="New Account" Click="CreateAccountButton_OnClick" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,16">
                  <Button Name="ResetAccountButton" Content="Reset to a New Account" Background="#35141E" BorderBrush="#713044" Click="ResetAccountButton_OnClick" />
                  <Button Name="DeleteAccountButton" Content="Delete Account" IsEnabled="False" Background="#45141B" BorderBrush="#A43B4A" ToolTip="Permanently deletes the selected account: its save data, Aime identity, card mappings and leftover backups" Click="DeleteAccountButton_OnClick" />
                  <Button Name="RepairAccountButton" Content="Repair Past Results" ToolTip="Replays the saved cabinet traffic to restore EXP, materials, Bond and Quest progress that an older build failed to save" Click="RepairAccountButton_OnClick" />
                  <Button Name="GrantBenefitsButton" Content="Grant Items" IsEnabled="False" Background="#28402F" BorderBrush="#4F8B63" ToolTip="Pick currency or materials from the installed game data and add a chosen amount to the selected account" Click="GrantBenefitsButton_OnClick" />
                  <Button Name="RefreshAccountsButton" Content="Refresh" Click="RefreshAccountsButton_OnClick" />
                  <Button Name="SummonHistoryButton" Content="Print History" IsEnabled="False" Click="SummonHistoryButton_OnClick" />
                  <TextBlock Name="CurrentSummonSummaryText" Text="Lv.1 - EXP 0 - 0 cards" Foreground="#E7C56A" VerticalAlignment="Center" Margin="8,3,3,3" />
                </WrapPanel>
                <TextBlock Text="One-Click Inventory and Growth" FontSize="18" FontWeight="SemiBold" Margin="3,4,0,8" />
                <TextBlock Text="These act on the selected account. Quit the game and stop the server first. The growth options only affect Servants the account already owns." Foreground="#BFB5C2" Margin="3,0,0,10" TextWrapping="Wrap" />
                <WrapPanel Name="AccountUpgradePanel" IsEnabled="False" MaxWidth="960" HorizontalAlignment="Left">
                  <FrameworkElement.Resources>
                    <ResourceDictionary>
                      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Width" Value="246" />
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="Margin" Value="3,3,9,9" />
                      </Style>
                    </ResourceDictionary>
                  </FrameworkElement.Resources>
                  <Button Content="Grant All Servants" Tag="servants" ToolTip="Tops every Servant card up to 5 copies through the normal print flow. Cards you already have more than 5 of are left alone, and running it again adds nothing." Click="AccountUpgrade_OnClick" />
                  <Button Content="Grant All Craft Essences" Tag="craft-essences" ToolTip="Tops every Craft Essence card up to 5 copies. Cards you already have more than 5 of are left alone, and running it again adds nothing." Click="AccountUpgrade_OnClick" />
                  <Button Content="Clear Present Box" Tag="clear-gifts" ToolTip="Deletes every unclaimed present without claiming it. The claim and delete history is kept, and the account is backed up first." Click="AccountUpgrade_OnClick" />
                  <Button Content="Clear All Quests" Tag="quests" ToolTip="Marks every Quest cleared and every Master Mission complete. You still claim the rewards yourself." Click="AccountUpgrade_OnClick" />
                  <Button Content="Max All Bond" Tag="bond" Click="AccountUpgrade_OnClick" />
                  <Button Content="Unlock All Costumes" Tag="costumes" Click="AccountUpgrade_OnClick" />
                  <Button Content="Max All Materials" Tag="materials" ToolTip="Fills every enhancement material in the installed data to its own cap" Click="AccountUpgrade_OnClick" />
                  <Button Content="Max All Servants" Tag="levels" ToolTip="Raises level, Ascension, level cap, Skills, support Skills, Noble Phantasm and Bond to the highest value available" Click="AccountUpgrade_OnClick" />
                </WrapPanel>
                <TextBlock Text="Account Details" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10" />
                <ItemsControl Name="AccountDetailsTable" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Cards and Deck">
            <TabControl Background="#101014" BorderBrush="#403545">
              <TabItem Header="Deck">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Name="SettingsPanelRow" Height="52" MinHeight="48" />
                    <RowDefinition Height="7" />
                    <RowDefinition Name="CardBrowserRow" Height="*" MinHeight="240" />
                    <RowDefinition Height="7" />
                    <RowDefinition Name="DeckPanelRow" Height="195" MinHeight="195" />
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="#403545" BorderThickness="1">
                    <Grid Margin="8">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Card Folder" Foreground="#A84F96" VerticalAlignment="Center" Margin="3" FontWeight="Bold" />
                      <TextBox Name="CardsPathTextBox" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" KeyDown="CardsPathTextBox_OnKeyDown" />
                      <Button Grid.Row="0" Grid.Column="2" Content="Reload" ToolTip="Read the card folder again" Click="ReloadButton_OnClick" />
                    </Grid>
                  </Border>
                  <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalPanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                  <Grid Row="2">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Name="CardListColumn" Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Background="#18131B" BorderBrush="#4A1D46" BorderThickness="1" Padding="7,3">
                      <StackPanel>
                        <DockPanel Margin="4,3,4,7" LastChildFill="False">
                          <TextBlock Text="Pick Servants and Craft Essences - double-click a card to choose its art and how many copies" Foreground="#B45A9F" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel LastChildFill="True">
                          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Show" Foreground="#BFB5C2" VerticalAlignment="Center" />
                            <ComboBox Name="CardTypeComboBox" Width="150" SelectedIndex="0" ToolTip="List Servant cards and Craft Essence cards separately">
                              <ComboBoxItem Content="All Cards" Tag="0" />
                              <ComboBoxItem Content="Servants" Tag="1" />
                              <ComboBoxItem Content="Craft Essences" Tag="2" />
                            </ComboBox>
                            <ToggleButton Name="OwnedCardsOnlyCheckBox" IsEnabled="False" VerticalAlignment="Center" Margin="8,3,3,3" ToolTip="Show only cards this account already owns. Cards still waiting to be printed are left out." Checked="OwnedCardsOnlyCheckBox_OnChanged" Unchecked="OwnedCardsOnlyCheckBox_OnChanged">
                              <FrameworkElement.Style>
                                <Style TargetType="{x:Type ToggleButton}">
                                  <Setter Property="Content" Value="Owned Only - Off" />
                                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                                  <Setter Property="Background" Value="#17131B" />
                                  <Setter Property="BorderBrush" Value="#3E3343" />
                                  <Setter Property="Padding" Value="9,3" />
                                  <Setter Property="FontWeight" Value="SemiBold" />
                                  <Setter Property="Template">
                                    <Setter.Value>
                                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Control.Padding}">
                                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                      </ControlTemplate>
                                    </Setter.Value>
                                  </Setter>
                                  <Style.Triggers>
                                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                                      <Setter Property="Content" Value="Owned Only - On" />
                                      <Setter Property="Background" Value="#5A1D50" />
                                      <Setter Property="BorderBrush" Value="#A85B9B" />
                                    </Trigger>
                                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                                      <Setter Property="BorderBrush" Value="#ED9BDC" />
                                    </Trigger>
                                    <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                                      <Setter Property="BorderBrush" Value="#ED9BDC" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                      <Setter Property="Background" Value="#78336C" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                      <Setter Property="UIElement.Opacity" Value="0.5" />
                                    </Trigger>
                                  </Style.Triggers>
                                </Style>
                              </FrameworkElement.Style>
                            </ToggleButton>
                          </StackPanel>
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Name="BuildThumbnailCacheButton" Content="Cache Thumbnails" Padding="9,3" ToolTip="Build a local JPEG thumbnail cache in DEVICE/cache/card-thumbnails" Click="BuildThumbnailCacheButton_OnClick" />
                            <TextBlock Text="View" Foreground="#BFB5C2" VerticalAlignment="Center" Margin="7,0,2,0" />
                            <Button Name="ListViewModeButton" Content="List" Padding="9,3" Click="ListViewModeButton_OnClick" />
                            <Button Name="IconViewModeButton" Content="Icons" Padding="9,3" Click="IconViewModeButton_OnClick" />
                          </StackPanel>
                        </DockPanel>
                        <TextBlock Name="CardCatalogSummaryText" Text="Reading the card folder..." Margin="4,3" Foreground="#D7BBDD" TextTrimming="CharacterEllipsis" />
                        <DockPanel Margin="0,4,0,0">
                          <TextBlock Text="Search" VerticalAlignment="Center" Margin="4,0,10,0" Foreground="#BFB5C2" />
                          <TextBox Name="SearchTextBox" VerticalContentAlignment="Center" ToolTip="Filter as you type by card name, id or file name. Clear the box to show everything again." TextChanged="CardPickerSearchBox_OnTextChanged" />
                        </DockPanel>
                      </StackPanel>
                    </Border>
                    <ListView Name="CardList" Grid.Row="1" Grid.Column="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" SelectionChanged="CardList_OnSelectionChanged" MouseDoubleClick="CardList_OnMouseDoubleClick">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CardStack}">
                          <Grid Margin="3" MinHeight="104">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="66" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#050506" BorderBrush="#493E4F" BorderThickness="1" Padding="2">
                              <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                              <TextBlock Foreground="#FFFFFFFF" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding JapaneseName}" />
                              <TextBlock Foreground="#D7BBDD" TextWrapping="Wrap" ToolTip="English name, from the official FGO NA name list where a match exists" Text="{Binding ChineseName}" />
                              <TextBlock Foreground="#BFB5C2" FontSize="11" Margin="0,4,0,0" Text="{Binding EntityLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8">
                              <Border Background="#351832" BorderBrush="#8A2E78" BorderThickness="1" Padding="8,3">
                                <TextBlock Foreground="#F2C8EA" FontSize="11" Text="{Binding StackLabel}" />
                              </Border>
                              <TextBlock Foreground="#A84F96" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right" Margin="0,7,0,0" Text="{Binding TrcId, StringFormat=TC ID {0}}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ListView>
                  </Grid>
                  <GridSplitter Grid.Row="3" Style="{StaticResource HorizontalPanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
                  <Border Grid.Row="4" Background="#0A090C" BorderBrush="#403545" BorderThickness="1">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <DockPanel Background="#18131B">
                        <TextBlock Name="DeckStatusText" DockPanel.Dock="Left" Foreground="#B45A9F" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                        <Button DockPanel.Dock="Right" Content="Clear Deck" Padding="10,3" Click="ClearButton_OnClick" />
                      </DockPanel>
                      <ListView Name="SelectedCardList" Grid.Row="1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="SelectedCardList_OnSelectionChanged" MouseDoubleClick="SelectedCardList_OnMouseDoubleClick">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:CardStack}">
                            <Grid Margin="4" Width="88" Height="142">
                              <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail}" />
                              <Border VerticalAlignment="Bottom" Background="#EA17121A" Padding="3">
                                <StackPanel>
                                  <Viewbox Height="14" Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock TextAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" Text="{Binding JapaneseName}" />
                                  </Viewbox>
                                  <Viewbox Height="14" Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock TextAlignment="Center" Foreground="#D7BBDD" FontSize="10" Text="{Binding ChineseName}" />
                                  </Viewbox>
                                  <TextBlock TextAlignment="Center" Foreground="#F2C8EA" FontSize="10" Text="{Binding Count, StringFormat=×{0}}" />
                                </StackPanel>
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ListView>
                    </Grid>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="Draw Rates">
                <ContentControl Name="SummonTabContent" Loaded="SummonTab_OnSelected" />
              </TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="Settings">
            <TabControl Background="#101014" BorderBrush="#403545">
              <TabItem Header="Display">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="Display and Resolution" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <WrapPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                        <TextBlock Text="Mode" VerticalAlignment="Center" Margin="3" Foreground="#BFB5C2" />
                        <ComboBox Name="DisplayModeComboBox" Width="152">
                          <ComboBoxItem Content="Windowed" Tag="windowed" />
                          <ComboBoxItem Content="Borderless" Tag="borderless" />
                          <ComboBoxItem Content="Fullscreen" Tag="exclusive" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                        <TextBlock Text="Monitor" VerticalAlignment="Center" Margin="8,3,3,3" Foreground="#BFB5C2" />
                        <ComboBox Name="MonitorComboBox" Width="262" ToolTip="The game uses this monitor the next time it starts. If that monitor is disconnected it falls back to the primary one." DropDownOpened="MonitorComboBox_OnDropDownOpened" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                        <TextBlock Text="Aspect" VerticalAlignment="Center" Margin="8,3,3,3" Foreground="#BFB5C2" />
                        <ComboBox Name="AspectRatioComboBox" Width="140" SelectionChanged="AspectRatioComboBox_OnSelectionChanged">
                          <ComboBoxItem Content="16:9" Tag="16:9" />
                          <ComboBoxItem Content="16:10" Tag="16:10" />
                          <ComboBoxItem Content="21:9" Tag="21:9" />
                          <ComboBoxItem Content="32:9" Tag="32:9" />
                          <ComboBoxItem Content="4:3" Tag="4:3" />
                          <ComboBoxItem Content="9:16 (portrait)" Tag="9:16" />
                          <ComboBoxItem Content="10:16 (portrait)" Tag="10:16" />
                          <ComboBoxItem Content="9:21 (portrait)" Tag="9:21" />
                          <ComboBoxItem Content="9:32 (portrait)" Tag="9:32" />
                          <ComboBoxItem Content="3:4 (portrait)" Tag="3:4" />
                          <ComboBoxItem Content="Custom" Tag="custom" />
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                        <ComboBox Name="ResolutionComboBox" Width="132" IsEditable="False" ToolTip="Resolution presets" SelectionChanged="ResolutionComboBox_OnSelectionChanged" />
                        <TextBox Name="CustomWidthTextBox" Width="58" MaxLength="4" VerticalContentAlignment="Center" ToolTip="Custom width, 480-7680" />
                        <TextBlock Text="×" VerticalAlignment="Center" Margin="2" Foreground="#BFB5C2" />
                        <TextBox Name="CustomHeightTextBox" Width="58" MaxLength="4" VerticalContentAlignment="Center" ToolTip="Custom height, 480-7680" />
                      </StackPanel>
                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,20">
                      <TextBlock Text="Frame Rate Cap" VerticalAlignment="Center" Margin="3" />
                      <ComboBox Name="FrameRateComboBox" Width="152">
                        <ComboBoxItem Content="60 FPS (stable)" Tag="60" />
                        <ComboBoxItem Content="90 FPS" Tag="90" />
                        <ComboBoxItem Content="120 FPS" Tag="120" />
                        <ComboBoxItem Content="144 FPS" Tag="144" />
                      </ComboBox>
                    </WrapPanel>
                    <TextBlock Text="Image Quality" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,12">
                      <TextBlock Text="Anti-aliasing" VerticalAlignment="Center" Margin="3" />
                      <ComboBox Name="SmaaComboBox" Width="232" SelectedIndex="0">
                        <ComboBoxItem Content="Off (native)" Tag="0" />
                        <ComboBoxItem Content="Native + SMAA High" Tag="1" />
                        <ComboBoxItem Content="Native + SMAA Ultra" Tag="2" />
                      </ComboBox>
                      <TextBlock Text="Anisotropic Filtering" VerticalAlignment="Center" Margin="12,3,3,3" />
                      <ComboBox Name="AnisotropyComboBox" Width="90" SelectedIndex="4">
                        <ComboBoxItem Content="1x" Tag="1" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="4x" Tag="4" />
                        <ComboBoxItem Content="8x" Tag="8" />
                        <ComboBoxItem Content="16x" Tag="16" />
                      </ComboBox>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,12">
                      <TextBlock Text="Render Scale" VerticalAlignment="Center" Margin="3" />
                      <ComboBox Name="RenderScaleComboBox" Width="232" SelectedIndex="0">
                        <ComboBoxItem Content="100% (native)" Tag="100" />
                        <ComboBoxItem Content="125% (1.56x pixels)" Tag="125" />
                        <ComboBoxItem Content="150% (2.25x pixels)" Tag="150" />
                        <ComboBoxItem Content="200% (4x pixels)" Tag="200" />
                      </ComboBox>
                    </WrapPanel>
                    <TextBlock Text="Renders the scene above your display resolution and scales it back down, so characters look sharper and edges are cleaner. The UI size and the field of view do not change, and it can be combined with SMAA." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,8" />
                    <TextBlock Text="The higher the scale, the more GPU it costs. Lower it if the game stutters. If your GPU cannot handle the setting, the game falls back to 100%." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,16">
                      <CheckBox Name="MotionBlurCheckBox" Content="Motion Blur" Margin="3,8,22,8" />
                      <CheckBox Name="DepthOfFieldCheckBox" Content="Depth of Field" IsChecked="True" Margin="3,8,22,8" />
                      <CheckBox Name="BloomCheckBox" Content="Bloom" IsChecked="True" Margin="3,8,22,8" />
                      <CheckBox Name="DisableCameraShakeCheckBox" Content="No Camera Shake" Margin="3,8,22,8" ToolTip="Removes the game's camera shake while leaving normal camera movement alone. Takes effect the next time you start the game." />
                    </WrapPanel>
                    <TextBlock Text="SMAA smooths the finished image, including UI text. Anisotropic filtering sharpens scene textures viewed at an angle." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,24" />
                    <WrapPanel Margin="0,0,0,12">
                      <TextBlock Text="Shadow Resolution" VerticalAlignment="Center" Margin="3,0,12,0" />
                      <ComboBox Name="ShadowResolutionComboBox" Width="210" SelectedIndex="0">
                        <ComboBoxItem Content="Game default" Tag="0" />
                        <ComboBoxItem Content="1024 x 1024" Tag="1024" />
                        <ComboBoxItem Content="2048 x 2048" Tag="2048" />
                        <ComboBoxItem Content="4096 x 4096" Tag="4096" />
                      </ComboBox>
                    </WrapPanel>
                    <TextBlock Text="Sets how sharp real-time cast shadows are. Ambient occlusion and baked shadows are not affected. A higher resolution costs more video memory and draw time. Takes effect the next time you start the game." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,24" />
                    <CheckBox Name="HideTargetLinesCheckBox" Content="Hide Enemy Lock-on Lines" Margin="3,0,0,8" />
                    <TextBlock Text="Hides only the connecting lines. Lock-on itself and the target marker still work. Takes effect the next time you start the game." TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,20" />
                    <TextBlock Text="Battle Damage Popups" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                    <Grid MaxWidth="680" HorizontalAlignment="Left" Width="Auto" Margin="0,0,0,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="182" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="65" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="38" />
                      </Grid.RowDefinitions>
                      <TextBlock Text="Damage Number Size" VerticalAlignment="Center" />
                      <Slider Name="DamageNumberScaleSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="Percentage; decimals are allowed" Text="{Binding Value, ElementName=DamageNumberScaleSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                      <TextBlock Grid.Row="1" Text="Number Opacity" VerticalAlignment="Center" />
                      <Slider Name="DamageNumberOpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="Percentage; decimals are allowed" Text="{Binding Value, ElementName=DamageNumberOpacitySlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                      <TextBlock Grid.Row="2" Text="Popup Graphic Size" VerticalAlignment="Center" />
                      <Slider Name="DamageTextureScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="200" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Row="2" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="Percentage; decimals are allowed" Text="{Binding Value, ElementName=DamageTextureScaleSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                      <TextBlock Grid.Row="3" Text="Graphic Opacity" VerticalAlignment="Center" />
                      <Slider Name="DamageTextureOpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                      <TextBox Grid.Row="3" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="Percentage; decimals are allowed" Text="{Binding Value, ElementName=DamageTextureOpacitySlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                    </Grid>
                    <TextBlock Text="Resizes the damage numbers and the Critical, Weak Point and Guard popups. No other part of the UI changes. Opacity 0% hides a popup, 100% leaves it as the game draws it." TextWrapping="Wrap" Foreground="#BFB5C2" />
                    <Button Content="Reset Damage Popups" HorizontalAlignment="Left" Margin="0,10,0,20" Click="ResetDamageUi_OnClick" />
                    <CheckBox Name="HideUiCheckBox" Content="Hide the UI When the Game Starts" Margin="3,8" />
                    <CheckBox Name="HideCabinetHudCheckBox" Content="Hide the Cabinet HUD: GP, CREDIT, the volume control and the status icons (the End Game button stays)" ToolTip="The hidden GP and volume controls also stop responding to touch. Actual audio output is unchanged. Takes effect the next time you start the game." Margin="3,8" />
                    <WrapPanel Margin="0,8,0,12">
                      <TextBlock Text="Show / Hide UI Shortcut" VerticalAlignment="Center" Margin="3,0,12,0" />
                      <Button Name="HideUiKeyButton" Content="F10" MinWidth="150" Click="HideUiKeyButton_OnClick" PreviewKeyDown="HideUiKeyButton_OnPreviewKeyDown" LostKeyboardFocus="HideUiKeyButton_OnLostKeyboardFocus" />
                    </WrapPanel>
                    <TextBlock Text="Click the button, then press the key you want. Esc cancels. The shortcut works while the game window has focus; press it again to bring the UI back." TextWrapping="Wrap" Foreground="#BFB5C2" />
                    <Separator Margin="0,24,0,12" />
                    <TextBlock Text="These settings take effect the next time you start the game. A wider aspect ratio shows more of the scene; the UI stays centred at its own ratio." TextWrapping="Wrap" Foreground="#BFB5C2" />
                    <Button Content="Save Display Settings" HorizontalAlignment="Left" Padding="24,8" Margin="0,16,0,8" Click="SaveGraphicsButton_OnClick" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Controls">
                <local:ControlSettingsView x:Name="ControlsPanel" SaveRequested="ControlsPanel_OnSaveRequested" />
              </TabItem>
              <TabItem Header="Audio">
                <local:AudioSettingsView />
              </TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="Advanced">
            <TabControl Background="#101014" BorderBrush="#403545">
              <TabItem Header="Server">
                <local:ServerSettingsView x:Name="ServerSettingsPanel" ConfigureRequested="ServerSettings_OnConfigure" />
              </TabItem>
              <TabItem Header="Diagnostics and Help">
                <local:DiagnosticsView />
              </TabItem>
              <TabItem Header="Mouse Cursor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <local:CursorSettingsView Margin="20" />
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Debug">
                <local:DebugSettingsView />
              </TabItem>
              <TabItem Header="Photo Mode">
                <ContentControl Name="PhotoTabContent" Loaded="PhotoSettings_OnClick" />
              </TabItem>
              <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Text="About" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="FGOA scooby - English build of the FGO Arcade local platform, version 1.01" TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,10" />
                    <TextBlock Text="FGOLocalPlatform by Cloud23333" Foreground="#F5F1F6" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="This program is free. If you paid for it, demand a full refund and report the seller." TextWrapping="Wrap" Foreground="#E7C56A" Margin="0,0,0,24" />
                    <TextBlock Text="Upstream project" Foreground="#B45A9F" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,24">
                      <Hyperlink Foreground="#BCDFFF" NavigateUri="https://gitea.tendokyu.moe/TeamTofuShop/segatools" RequestNavigate="AboutLink_OnRequestNavigate">https://gitea.tendokyu.moe/TeamTofuShop/segatools</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="11.00 fixes, rendering fixes, one-click local deployment and the extra features" TextWrapping="Wrap" Foreground="#B45A9F" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Margin="0,0,0,24">
                      <Hyperlink Foreground="#BCDFFF" NavigateUri="https://space.bilibili.com/13236455" RequestNavigate="AboutLink_OnRequestNavigate">bilibili Cloud23333</Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Translation tool" Foreground="#B45A9F" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Margin="0,0,0,24">
                      <Hyperlink Foreground="#BCDFFF" NavigateUri="https://space.bilibili.com/13236455" RequestNavigate="AboutLink_OnRequestNavigate">bilibili Cloud23333</Hyperlink>
                    </TextBlock>
                    <Separator Margin="0,0,0,24" />
                    <TextBlock Text="Special thanks" Foreground="#E7C56A" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
                    <TextBlock TextWrapping="Wrap" FontSize="16">
                      <Run Text="Everyone who backed the project on Aizhuzhu" />
                      <InlineUIContainer BaselineAlignment="Center">
                        <Image Source="/FGOLocalPlatform;component/Assets/crying-emoji.png" Width="22" Height="22" Margin="1,0" AutomationProperties.Name="😭" RenderOptions.BitmapScalingMode="HighQuality" />
                      </InlineUIContainer>
                      <Run Text=" - it would not have got this far without you" />
                    </TextBlock>
                    <TextBlock Margin="0,10,0,0">
                      <Hyperlink Foreground="#BCDFFF" NavigateUri="https://azz.ee/Cloud23333" RequestNavigate="AboutLink_OnRequestNavigate">Cloud23333 on Aizhuzhu</Hyperlink>
                    </TextBlock>
                    <local:EasterEggSettingsView Margin="0,24,0,0" />
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </TabItem>
        </TabControl>
        <GridSplitter Name="LogPanelSplitter" Grid.Column="1" Style="{StaticResource PanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
        <Grid Name="LogPanel" Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Name="ServerLogRow" Height="*" MinHeight="150" />
            <RowDefinition Height="7" />
            <RowDefinition Name="InjectionLogRow" Height="*" MinHeight="150" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#08070A" BorderBrush="#4A1D46" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#1A111B" BorderBrush="#4A1D46" BorderThickness="0,0,0,1">
                <DockPanel Margin="10,0" LastChildFill="False">
                  <TextBlock Text="SERVER LOG" FontWeight="Bold" Foreground="#B45A9F" VerticalAlignment="Center" />
                  <TextBlock Text="LIVE" DockPanel.Dock="Right" Foreground="#9CF6C8" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <TextBox Name="ServerLogTextBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="0" Padding="9" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Grid>
          </Border>
          <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalPanelSplitterStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
          <Border Grid.Row="2" Background="#08070A" BorderBrush="#3E3343" BorderThickness="1">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#151217" BorderBrush="#3E3343" BorderThickness="0,0,0,1">
                <DockPanel Margin="10,0" LastChildFill="False">
                  <TextBlock Text="GAME LOG" FontWeight="Bold" Foreground="#E9E3EB" VerticalAlignment="Center" />
                  <TextBlock Text="TAIL" DockPanel.Dock="Right" Foreground="#9D6A96" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
              <TextBox Name="InjectionLogTextBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Margin="0" Padding="9" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="3" Background="#0C0A0E" BorderBrush="#34283A" BorderThickness="0,1,0,0">
        <Grid Margin="12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Name="RuntimeStatusText" VerticalAlignment="Center" Foreground="#B45A9F" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <Button Name="ToggleLogsButton" Grid.Column="2" Content="Hide Logs ▶" Padding="8,2" Margin="12,2,0,2" Click="ToggleLogs_OnClick" />
          <TextBlock Name="FooterNoticeText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#E7C56A" FontSize="11" FontWeight="SemiBold" Margin="18,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>