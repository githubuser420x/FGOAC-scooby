                    <RowDefinition Height="38" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="38" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="伤害数字大小" VerticalAlignment="Center" />
                  <Slider Name="DamageNumberScaleSlider" Grid.Column="1" Minimum="0" Maximum="200" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                  <TextBox Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="百分比，可输入小数" Text="{Binding Value, ElementName=DamageNumberScaleSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                  <TextBlock Grid.Row="1" Text="数字不透明度" VerticalAlignment="Center" />
                  <Slider Name="DamageNumberOpacitySlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="百分比，可输入小数" Text="{Binding Value, ElementName=DamageNumberOpacitySlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                  <TextBlock Grid.Row="2" Text="提示纹理大小" VerticalAlignment="Center" />
                  <Slider Name="DamageTextureScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="200" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="百分比，可输入小数" Text="{Binding Value, ElementName=DamageTextureScaleSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                  <TextBlock Grid.Row="3" Text="纹理不透明度" VerticalAlignment="Center" />
                  <Slider Name="DamageTextureOpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="100" SmallChange="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                  <TextBox Grid.Row="3" Grid.Column="2" Margin="8,3,0,3" VerticalContentAlignment="Center" ToolTip="百分比，可输入小数" Text="{Binding Value, ElementName=DamageTextureOpacitySlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F1, ValidatesOnExceptions=True}" />
                </Grid>
                <TextBlock Text="调整伤害数字及暴击、弱点、格挡等弹出提示，不影响其他界面。不透明度 0% 为隐藏，100% 为原样。" TextWrapping="Wrap" Foreground="#BFB5C2" />
                <Button Content="恢复伤害提示默认值" HorizontalAlignment="Left" Margin="0,10,0,20" Click="ResetDamageUi_OnClick" />
                <CheckBox Name="HideUiCheckBox" Content="进入游戏时隐藏 UI" Margin="3,8" />
                <CheckBox Name="HideCabinetHudCheckBox" Content="隐藏 GP、CREDIT、右下角音量和状态图标（保留结束游戏按钮）" ToolTip="同时禁用隐藏的 GP 与音量控件触摸；不影响实际音频输出。保存后下次启动游戏生效。" Margin="3,8" />
                <WrapPanel Margin="0,8,0,12">
                  <TextBlock Text="显示 / 隐藏 UI 快捷键" VerticalAlignment="Center" Margin="3,0,12,0" />
                  <Button Name="HideUiKeyButton" Content="F10" MinWidth="150" Click="HideUiKeyButton_OnClick" PreviewKeyDown="HideUiKeyButton_OnPreviewKeyDown" LostKeyboardFocus="HideUiKeyButton_OnLostKeyboardFocus" />
                </WrapPanel>
                <TextBlock Text="点击快捷键按钮后按键绑定，Esc 取消。游戏获得焦点时生效，再按一次恢复 UI。" TextWrapping="Wrap" Foreground="#BFB5C2" />
                <Separator Margin="0,24,0,12" />
                <TextBlock Text="保存后，下次启动游戏生效。宽屏扩展场景视野，UI 保持居中比例。" TextWrapping="Wrap" Foreground="#BFB5C2" />
                <Button Content="保存画面设置" HorizontalAlignment="Left" Padding="24,8" Margin="0,16,0,8" Click="SaveGraphicsButton_OnClick" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
