              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="#151217" BorderBrush="#3E3343" BorderThickness="0,0,0,1">
