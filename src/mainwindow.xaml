                  <Button Content="全从者好感一键最大值" Tag="bond" Click="AccountUpgrade_OnClick" />
                  <Button Content="全灵衣一键解锁" Tag="costumes" Click="AccountUpgrade_OnClick" />
                  <Button Content="全素材一键满值" Tag="materials" ToolTip="将全部已安装强化素材补至各自上限" Click="AccountUpgrade_OnClick" />
                  <Button Content="全从者一键满级" Tag="levels" ToolTip="等级、再临、等级上限、技能、支援技能、宝具及羁绊达到可用上限" Click="AccountUpgrade_OnClick" />
                </WrapPanel>
                <TextBlock Text="账号详情" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10" />
                <ItemsControl Name="AccountDetailsTable" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="抽卡概率">
            <ContentControl Name="SummonTabContent" Loaded="SummonTab_OnSelected" />
          </TabItem>
          <TabItem Header="控制">
            <local:ControlSettingsView x:Name="ControlsPanel" SaveRequested="ControlsPanel_OnSaveRequested" />
          </TabItem>
          <TabItem Header="鼠标指针">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <local:CursorSettingsView Margin="20" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="画面设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Stretch">
                <TextBlock Text="显示与分辨率" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                    <TextBlock Text="显示" VerticalAlignment="Center" Margin="3" Foreground="#BFB5C2" />
                    <ComboBox Name="DisplayModeComboBox" Width="125">
                      <ComboBoxItem Content="窗口化" Tag="windowed" />
                      <ComboBoxItem Content="无边框全屏" Tag="borderless" />
                      <ComboBoxItem Content="独占全屏" Tag="exclusive" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                    <TextBlock Text="屏幕" VerticalAlignment="Center" Margin="8,3,3,3" Foreground="#BFB5C2" />
                    <ComboBox Name="MonitorComboBox" Width="210" ToolTip="下次启动游戏时使用所选屏幕；屏幕断开时回退到主屏。" DropDownOpened="MonitorComboBox_OnDropDownOpened" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                    <TextBlock Text="比例" VerticalAlignment="Center" Margin="8,3,3,3" Foreground="#BFB5C2" />
                    <ComboBox Name="AspectRatioComboBox" Width="82" SelectionChanged="AspectRatioComboBox_OnSelectionChanged">
                      <ComboBoxItem Content="16:9" Tag="16:9" />
                      <ComboBoxItem Content="16:10" Tag="16:10" />
                      <ComboBoxItem Content="21:9" Tag="21:9" />
                      <ComboBoxItem Content="32:9" Tag="32:9" />
                      <ComboBoxItem Content="4:3" Tag="4:3" />
                      <ComboBoxItem Content="9:16（竖）" Tag="9:16" />
                      <ComboBoxItem Content="10:16（竖）" Tag="10:16" />
                      <ComboBoxItem Content="9:21（竖）" Tag="9:21" />
                      <ComboBoxItem Content="9:32（竖）" Tag="9:32" />
                      <ComboBoxItem Content="3:4（竖）" Tag="3:4" />
                      <ComboBoxItem Content="自定义" Tag="custom" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                    <ComboBox Name="ResolutionComboBox" Width="118" IsEditable="False" ToolTip="分辨率预设" SelectionChanged="ResolutionComboBox_OnSelectionChanged" />
                    <TextBox Name="CustomWidthTextBox" Width="58" MaxLength="4" VerticalContentAlignment="Center" ToolTip="自定义宽度 480–7680" />
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="2" Foreground="#BFB5C2" />
                    <TextBox Name="CustomHeightTextBox" Width="58" MaxLength="4" VerticalContentAlignment="Center" ToolTip="自定义高度 480–7680" />
                  </StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,20">
                  <TextBlock Text="帧率上限" VerticalAlignment="Center" Margin="3" />
                  <ComboBox Name="FrameRateComboBox" Width="135">
                    <ComboBoxItem Content="60 FPS（稳定）" Tag="60" />
                    <ComboBoxItem Content="90 FPS" Tag="90" />
                    <ComboBoxItem Content="120 FPS" Tag="120" />
                    <ComboBoxItem Content="144 FPS" Tag="144" />
                  </ComboBox>
                </WrapPanel>
                <TextBlock Text="画面质量" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <WrapPanel Margin="0,0,0,12">
                  <TextBlock Text="抗锯齿" VerticalAlignment="Center" Margin="3" />
                  <ComboBox Name="SmaaComboBox" Width="210" SelectedIndex="0">
                    <ComboBoxItem Content="原生" Tag="0" />
                    <ComboBoxItem Content="原生 + SMAA 高" Tag="1" />
                    <ComboBoxItem Content="原生 + SMAA 极高" Tag="2" />
                  </ComboBox>
                  <TextBlock Text="场景各向异性过滤" VerticalAlignment="Center" Margin="12,3,3,3" />
                  <ComboBox Name="AnisotropyComboBox" Width="90" SelectedIndex="4">
                    <ComboBoxItem Content="1×" Tag="1" />
                    <ComboBoxItem Content="2×" Tag="2" />
                    <ComboBoxItem Content="4×" Tag="4" />
                    <ComboBoxItem Content="8×" Tag="8" />
                    <ComboBoxItem Content="16×" Tag="16" />
                  </ComboBox>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,12">
                  <TextBlock Text="渲染倍率" VerticalAlignment="Center" Margin="3" />
                  <ComboBox Name="RenderScaleComboBox" Width="210" SelectedIndex="0">
                    <ComboBoxItem Content="100%（原生分辨率）" Tag="100" />
                    <ComboBoxItem Content="125%（1.56 倍像素）" Tag="125" />
                    <ComboBoxItem Content="150%（2.25 倍像素）" Tag="150" />
                    <ComboBoxItem Content="200%（4 倍像素）" Tag="200" />
                  </ComboBox>
                </WrapPanel>
                <TextBlock Text="让场景和卡槽中的人物更细腻，减轻边缘锯齿；界面大小与视野不变，也可以搭配 SMAA 使用。" TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,8" />
                <TextBlock Text="倍率越高，对显卡的要求也越高。如果感觉卡顿，可以适当调低；显卡不支持当前设置时，会自动使用 100%。" TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,8" />
                <WrapPanel Margin="0,0,0,16">
                  <CheckBox Name="MotionBlurCheckBox" Content="动态模糊" Margin="3,8,22,8" />
                  <CheckBox Name="DepthOfFieldCheckBox" Content="景深" IsChecked="True" Margin="3,8,22,8" />
                  <CheckBox Name="BloomCheckBox" Content="辉光" IsChecked="True" Margin="3,8,22,8" />
                  <CheckBox Name="DisableCameraShakeCheckBox" Content="关闭镜头抖动" Margin="3,8,22,8" ToolTip="取消游戏的镜头震动叠加，保留正常运镜；保存后下次启动游戏生效。" />
                </WrapPanel>
                <TextBlock Text="SMAA 对最终画面追加抗锯齿，包含界面文字。各向异性过滤作用于场景材质。" TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,24" />
                <WrapPanel Margin="0,0,0,12">
                  <TextBlock Text="实时投射阴影分辨率" VerticalAlignment="Center" Margin="3,0,12,0" />
                  <ComboBox Name="ShadowResolutionComboBox" Width="210" SelectedIndex="0">
                    <ComboBoxItem Content="原版" Tag="0" />
                    <ComboBoxItem Content="1024 × 1024" Tag="1024" />
                    <ComboBoxItem Content="2048 × 2048" Tag="2048" />
                    <ComboBoxItem Content="4096 × 4096" Tag="4096" />
                  </ComboBox>
                </WrapPanel>
                <TextBlock Text="调整实时级联阴影的清晰度，不改变 AO 或烘焙阴影；分辨率越高，显存和绘制开销越大。保存后重新启动游戏生效。" TextWrapping="Wrap" Foreground="#BFB5C2" Margin="0,0,0,24" />
                <CheckBox Name="HideTargetLinesCheckBox" Content="隐藏敌人锁定曲线" Margin="3,0,0,8" />
