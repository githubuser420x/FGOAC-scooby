<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="FGOLocalPlatform.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FGOLocalPlatform" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>

      <!-- The night screens of the game: a navy-to-black ground, dark plates, one cyan accent,
           and gold only as a rim, an ornament or a key word. -->
      <SolidColorBrush x:Key="NightTopBrush" Color="#0B1B3A" />
      <SolidColorBrush x:Key="NightBottomBrush" Color="#050A16" />
      <SolidColorBrush x:Key="PlateBrush" Color="#10203F" />
      <SolidColorBrush x:Key="PlateHighBrush" Color="#1A3468" />
      <SolidColorBrush x:Key="PlateLowBrush" Color="#0C1A36" />
      <SolidColorBrush x:Key="LineBrush" Color="#23406F" />
      <SolidColorBrush x:Key="LineSoftBrush" Color="#1A2F52" />

      <SolidColorBrush x:Key="IceBrush" Color="#7FD6F2" />
      <SolidColorBrush x:Key="IceDimBrush" Color="#4E9CBC" />
      <SolidColorBrush x:Key="IceDeepBrush" Color="#16344A" />
      <SolidColorBrush x:Key="GoldBrush" Color="#C9A24D" />
      <SolidColorBrush x:Key="GoldSoftBrush" Color="#8A6E33" />

      <SolidColorBrush x:Key="TextBrush" Color="#E8EEF8" />
      <SolidColorBrush x:Key="TextSoftBrush" Color="#9DB0CC" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#7286A6" />

      <SolidColorBrush x:Key="DangerBrush" Color="#F2708A" />
      <SolidColorBrush x:Key="DangerFillBrush" Color="#3A1220" />
      <SolidColorBrush x:Key="DangerEdgeBrush" Color="#7E2E43" />
      <SolidColorBrush x:Key="DangerFillStrongBrush" Color="#4A1526" />
      <SolidColorBrush x:Key="DangerEdgeStrongBrush" Color="#A63F58" />
      <SolidColorBrush x:Key="ReadyBrush" Color="#79E0A8" />
      <SolidColorBrush x:Key="ReadyFillBrush" Color="#123023" />
      <SolidColorBrush x:Key="ReadyEdgeBrush" Color="#3E7F5B" />

      <LinearGradientBrush x:Key="NightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#0B1B3A" />
        <GradientStop Offset="1" Color="#050A16" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="BandBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#16294A" />
        <GradientStop Offset="1" Color="#0A1729" />
      </LinearGradientBrush>

      <!-- The game's own display face, swapped in at startup by GameFont; this is the fallback. -->
      <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>
      <FontFamily x:Key="UiFont">Segoe UI, Yu Gothic UI, Microsoft YaHei UI</FontFamily>
      <FontFamily x:Key="DigitFont">Cascadia Mono, Consolas</FontFamily>

      <!-- The L bracket in the corner of the game's panels, and the two control glyphs. -->
      <Geometry x:Key="CornerOrnamentGeometry">M 0,16 L 0,5 L 5,0 L 16,0 M 2.5,10 L 2.5,6.5 L 6.5,2.5 L 10,2.5</Geometry>
      <Geometry x:Key="CheckGeometry">M 0,5 L 4,9 L 11,1</Geometry>
      <Geometry x:Key="ChevronGeometry">M 0,0 L 5,5 L 10,0</Geometry>

      <!-- Shown only when the keyboard put the focus there, never on a click. -->
      <Style x:Key="IceFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="2" Stroke="{StaticResource IceBrush}" StrokeThickness="2" SnapsToDevicePixels="True" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>

      <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      </Style>

      <Style x:Key="LabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
      </Style>

      <Style x:Key="HelpTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
      </Style>

      <Style x:Key="SecondaryNameStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="ToolTip" Value="Japanese name, as the cabinet prints it" />
        <Style.Triggers>
          <Trigger Property="Text" Value="">
            <Setter Property="Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- The readout band: a dark gradient with a gold rim, the shape the game puts its readouts in. -->
      <Style x:Key="StatusBandStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BandBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>

      <!-- The key word on a band, in the game's face and the game's pale gold. -->
      <Style x:Key="BandKeyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="BandValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>

      <!-- Secondary button: the game's menu plate, a cyan rule under the label. -->
      <Style TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="16,7,16,5" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <local:ChamferPanel Name="Plate" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" Cut="8" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                  <Border Name="Rule" Grid.Row="1" Height="2" Margin="2,5,2,0" Background="{StaticResource IceDimBrush}" />
                </Grid>
              </local:ChamferPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PlateHighBrush}" />
                  <Setter TargetName="Rule" Property="Background" Value="{StaticResource IceBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PlateLowBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                  <Setter TargetName="Rule" Property="Background" Value="{StaticResource LineSoftBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Primary: the same plate with a gold rim. Larger, never filled gold. -->
      <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="30,9" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <local:ChamferPanel Name="Plate" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.4" Cut="12" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </local:ChamferPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PlateHighBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PlateLowBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Anything that throws work away. -->
      <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerEdgeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      </Style>

      <Style x:Key="DestructiveButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource DangerFillStrongBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerEdgeStrongBrush}" />
      </Style>

      <Style x:Key="GrantButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource ReadyFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ReadyEdgeBrush}" />
      </Style>

      <!-- A switch: the plate with a box that takes a cyan check when it is on. -->
      <Style x:Key="SwitchToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border Name="Box" Width="18" Height="18" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <Path Name="Tick" Data="{StaticResource CheckGeometry}" Stretch="Uniform" Width="11" Height="10" Stroke="{StaticResource IceBrush}" StrokeThickness="2" StrokeEndLineCap="Square" Visibility="Collapsed" />
                  </Border>
                  <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Plate" Property="Background" Value="{StaticResource PlateHighBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Fields are inset, with the rule along the bottom that lights up on focus. -->
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{StaticResource PlateLowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="CaretBrush" Value="{StaticResource IceBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource IceDeepBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <Grid>
                  <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Background="#00FFFFFF" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                  <Border Name="Rule" Height="2" VerticalAlignment="Bottom" Background="{StaticResource LineBrush}" IsHitTestVisible="False" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Rule" Property="Background" Value="{StaticResource IceBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Background" Value="{StaticResource PlateLowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              <Setter Property="Background" Value="{StaticResource PlateBrush}" />
              <Setter Property="Padding" Value="11,8" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="#00FFFFFF" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateHighBrush}" />
                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Border Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                  <Grid>
                    <ToggleButton Focusable="False" Background="#00FFFFFF" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                      <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                          <Border Background="#00FFFFFF">
                            <Path Data="{StaticResource ChevronGeometry}" Width="11" Height="6" Stretch="Fill" Stroke="{StaticResource IceBrush}" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" />
                          </Border>
                        </ControlTemplate>
                      </ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Name="SelectionPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="False" Margin="9,0,32,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                    <TextBox Name="PART_EditableTextBox" Visibility="Hidden" Background="#00FFFFFF" BorderThickness="0" Margin="5,0,32,0" VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}" IsReadOnly="{TemplateBinding IsReadOnly}" />
                    <Border Name="Rule" Height="2" Background="{StaticResource LineBrush}" VerticalAlignment="Bottom" IsHitTestVisible="False" />
                  </Grid>
                </Border>
                <Popup Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}" MaxWidth="{TemplateBinding ActualWidth}" MaxHeight="340">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Rule" Property="Background" Value="{StaticResource IceBrush}" />
                </Trigger>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Hidden" />
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ComboBorder" Property="Opacity" Value="0.38" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- The check boxes in this app are full-width option plates, so that is what they look like. -->
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,4,8,4" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Border Name="Plate" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Name="Box" Width="18" Height="18" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                    <Path Name="Tick" Data="{StaticResource CheckGeometry}" Stretch="Uniform" Width="11" Height="10" Stroke="{StaticResource IceBrush}" StrokeThickness="2" StrokeEndLineCap="Square" Visibility="Collapsed" />
                  </Border>
                  <ContentPresenter Grid.Column="1" Margin="12,0,2,0" RecognizesAccessKey="True" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                    <ContentPresenter.Resources>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="TextWrapping" Value="Wrap" />
                      </Style>
                    </ContentPresenter.Resources>
                  </ContentPresenter>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Plate" Property="Background" Value="{StaticResource PlateHighBrush}" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                  <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Slider}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource IceBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid Background="#00FFFFFF">
                <Border Height="4" VerticalAlignment="Center" Background="{StaticResource PlateLowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                      <RepeatButton.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Height="4" VerticalAlignment="Center" Background="{StaticResource IceDimBrush}" />
                        </ControlTemplate>
                      </RepeatButton.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                      <RepeatButton.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </RepeatButton.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="16" Height="24">
                      <Thumb.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Grid Background="#00FFFFFF">
                            <Border Name="Grip" Width="10" Height="22" Background="{StaticResource PlateHighBrush}" BorderBrush="{StaticResource IceBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="Grip" Property="Background" Value="{StaticResource IceDeepBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                              <Setter TargetName="Grip" Property="Background" Value="{StaticResource IceDeepBrush}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Tabs are the same plates in a row; the selected one is lit and underlined in cyan. -->
      <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource IceFocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <local:ChamferPanel Name="Plate" Fill="{StaticResource PlateLowBrush}" Stroke="{StaticResource LineSoftBrush}" StrokeThickness="1" Cut="9" Margin="0,0,5,0" MinHeight="46" MinWidth="104" Padding="20,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                  <Border Name="Rule" Grid.Row="1" Height="2" Margin="0,0,0,8" Background="#00FFFFFF" />
                </Grid>
              </local:ChamferPanel>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PlateHighBrush}" />
                  <Setter TargetName="Plate" Property="Stroke" Value="{StaticResource LineBrush}" />
                  <Setter TargetName="Rule" Property="Background" Value="{StaticResource IceBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Plate" Property="Fill" Value="{StaticResource PlateBrush}" />
                  <Setter TargetName="Rule" Property="Background" Value="{StaticResource IceDimBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Plate" Property="Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Padding" Value="0" />
      </Style>

      <Style TargetType="{x:Type ListView}">
        <Setter Property="Background" Value="{StaticResource NightBottomBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      </Style>

      <!-- List rows are card plates; the selected one is lit and rimmed in cyan. -->
      <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListViewItem}">
              <Border Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PlateHighBrush}" />
                  <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource NightBottomBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineSoftBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource LineSoftBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource PlateBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource PlateBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeaderWidth" Value="0" />
      </Style>

      <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,2" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
      </Style>

      <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource PlateBrush}" />
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource PlateHighBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="#00FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Width="11" Background="{StaticResource PlateLowBrush}">
          <Track Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Background="{StaticResource LineBrush}" MinHeight="36">
                <Thumb.Template>
                  <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Name="ThumbBody" Background="{TemplateBinding Background}" Margin="3,1" />
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource IceDimBrush}" />
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource IceBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
            </Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate>

      <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="11" Background="{StaticResource PlateLowBrush}">
          <Track Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb Background="{StaticResource LineBrush}" MinWidth="36">
                <Thumb.Template>
                  <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Name="ThumbBody" Background="{TemplateBinding Background}" Margin="1,3" />
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource IceDimBrush}" />
                      </Trigger>
                      <Trigger Property="IsDragging" Value="True">
                        <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource IceBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" />
            </Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate>

      <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="Background" Value="{StaticResource NightBottomBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollViewer}">
              <Grid Background="{TemplateBinding Background}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollContentPresenter Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                <ScrollBar Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PlateLowBrush}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Separator}">
              <Border Height="1" Background="{TemplateBinding Background}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Expander}">
              <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ToggleButton Name="HeaderButton" MinHeight="42" Cursor="Hand" Focusable="True" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Name="HeaderSurface" Background="#00FFFFFF" Padding="14,10">
                          <StackPanel Orientation="Horizontal">
                            <Path Name="Chevron" Data="{StaticResource ChevronGeometry}" Width="11" Height="6" Stretch="Fill" Stroke="{StaticResource IceBrush}" StrokeThickness="1.6" Margin="0,0,11,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource IceBrush}" />
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSurface" Property="Background" Value="{StaticResource PlateBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                    <ContentPresenter ContentSource="Header" />
                  </ToggleButton>
                  <Border Name="Body" Grid.Row="1" Visibility="Collapsed" Padding="14,0,14,12">
                    <ContentPresenter />
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                  <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ItemsPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Border Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="#00FFFFFF" BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" Foreground="{StaticResource TextSoftBrush}" />
                  <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False">
                    <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="4">
                      <ItemsPresenter />
                    </Border>
                  </Popup>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                  <Setter TargetName="MenuSurface" Property="Background" Value="{StaticResource PlateHighBrush}" />
                  <Setter TargetName="MenuSurface" Property="BorderBrush" Value="{StaticResource IceBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="MenuSurface" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ToolTip}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GoldSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToolTip}">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter>
                  <ContentPresenter.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type Window}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Background" Value="{StaticResource NightBottomBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      </Style>

      <Style TargetType="{x:Type UserControl}">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
