<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.CardVariantsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Choose Card Type and Quantity" Background="{StaticResource PlateBrush}" Foreground="{StaticResource TextBrush}" Width="880" Height="650" MinWidth="700" MinHeight="440" WindowStartupLocation="CenterOwner" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Style="{StaticResource SectionTitleStyle}" FontSize="21" TextWrapping="Wrap" Text="{Binding EnglishName}" />
      <TextBlock Style="{StaticResource SecondaryNameStyle}" TextWrapping="Wrap" Text="{Binding JapaneseName}" />
      <TextBlock Foreground="{StaticResource TextSoftBrush}" Text="{Binding EntityLabel}" />
      <TextBlock Name="Hint" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
    <Border Name="CraftPreview" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PlateBrush}" Padding="12" Margin="0,0,0,12">
      <Grid Height="235">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Name="CraftImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
          <StackPanel>
            <TextBlock Text="Normal Effect" Foreground="{StaticResource TextBrush}" FontWeight="Bold" />
            <TextBlock Name="NormalEffect" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
            <TextBlock Text="Max Limit Break Effect" Foreground="{StaticResource TextBrush}" FontWeight="Bold" />
            <TextBlock Name="MaximumEffect" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
            <TextBlock Text="Hover the effect text to see the Japanese original." Foreground="{StaticResource TextSoftBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <DataGrid Name="Forms" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinRowHeight="105" SelectionChanged="Forms_OnSelectionChanged" MouseDoubleClick="Forms_OnMouseDoubleClick">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="CenteredCell" TargetType="{x:Type TextBlock}">
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6" />
          </Style>
          <Style x:Key="CenteredEdit" TargetType="{x:Type TextBox}">
            <Setter Property="TextBox.TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
          </Style>
          <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
          </Style>
          <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Card" Width="78" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image Height="100" Width="70" Stretch="Uniform" Source="{Binding Card.Thumbnail}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn ElementStyle="{StaticResource CenteredCell}" EditingElementStyle="{StaticResource CenteredEdit}" Header="Type / Stage / Card Number" Width="*" MinWidth="240" IsReadOnly="True" Binding="{Binding Label}" />
        <DataGridTextColumn ElementStyle="{StaticResource CenteredCell}" EditingElementStyle="{StaticResource CenteredEdit}" Header="Owned" Width="85" IsReadOnly="True" Binding="{Binding Owned}" />
        <DataGridTextColumn ElementStyle="{StaticResource CenteredCell}" EditingElementStyle="{StaticResource CenteredEdit}" Header="In Deck" Width="85" IsReadOnly="True" Binding="{Binding Selected}" />
        <DataGridTextColumn ElementStyle="{StaticResource CenteredCell}" EditingElementStyle="{StaticResource CenteredEdit}" Header="Can Add" Width="85" IsReadOnly="True" Binding="{Binding Maximum}" />
        <DataGridTextColumn ElementStyle="{StaticResource CenteredCell}" EditingElementStyle="{StaticResource CenteredEdit}" Header="Quantity" Width="100" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <TextBlock Name="Error" Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" />
        <Button Content="Add Selected Quantities" Click="Add_OnClick" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>