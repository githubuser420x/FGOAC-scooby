<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock Text="Diagnostics and Help" FontSize="22" FontWeight="Bold" />
      <Button Name="EnvironmentCheckButton" Content="Run Environment Check" HorizontalAlignment="Left" Padding="18,10" Margin="0,16,0,8" Click="EnvironmentCheck_OnClick" />
      <TextBlock Name="EnvironmentCheckText" Text="Checks the runtime libraries, script versions, audio device and folder permissions; it does not start the server. The report is saved to logs/environment-check.txt." TextWrapping="Wrap" />
      <TextBlock Text="Error Codes and Fixes" Foreground="{StaticResource TextBrush}" FontWeight="Bold" Margin="0,16,0,0" />
      <TextBlock Name="ErrorGuideText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="8,12,8,12" />
    </StackPanel>
  </ScrollViewer>
</UserControl>