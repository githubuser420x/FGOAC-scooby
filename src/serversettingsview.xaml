<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FGOLocalPlatform.ServerSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform" Loaded="View_OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="auto reaches the server on this PC through the built-in virtual network and works with no internet. Enter another IPv4 address to use a remote server instead." />
      <Grid>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
              <Setter Property="TextBox.TextAlignment" Value="Center" />
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
          <RowDefinition Height="44" />
        </Grid.RowDefinitions>
        <TextBlock Text="Server address (auto = offline)" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="HostBox" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="Game / ALL.Net port" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="HttpBox" Grid.Row="1" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="Billing HTTPS port" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="BillingBox" Grid.Row="2" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="Aime card reader port" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="AimeBox" Grid.Row="3" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
        <TextBlock Text="Local database port" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource TextSoftBrush}" />
        <TextBox Name="DatabaseBox" Grid.Row="4" Grid.Column="1" Margin="0,5" VerticalContentAlignment="Center" />
      </Grid>
      <WrapPanel Margin="0,16,0,16">
        <Button Content="Save Settings" Width="160" Padding="12,6" Margin="0,0,8,0" Click="Configure_OnClick" />
        <Button Content="Restore Defaults" Width="160" Padding="12,6" Margin="0,0,8,0" Click="Defaults_OnClick" />
        <Button Content="Refresh Status" Width="160" Padding="12,6" Click="Refresh_OnClick" />
      </WrapPanel>
      <TextBlock Text="Ports must be whole numbers from 1 to 65535 and no two services can share one. Saving stops the local server, so quit the game first. Neither saving nor opening this page starts the server. Restore Defaults only fills in the boxes - click Save Settings to apply them." Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" />
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="{StaticResource PlateBrush}" Padding="14">
        <TextBlock Name="InfoText" Text="Reading configuration..." TextWrapping="Wrap" LineHeight="20" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>