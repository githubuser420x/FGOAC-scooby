<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FGOLocalPlatform.NewAccountDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="New Local Account" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource GroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" xmlns:fgolocalplatform="clr-namespace:FGOLocalPlatform;assembly=FGOLocalPlatform">
  <Border Background="{StaticResource PlateBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20" Margin="10">
    <StackPanel>
      <TextBlock Text="Master name (shown in game)" FontSize="13" Foreground="{StaticResource TextSoftBrush}" />
      <TextBox Name="MasterNameTextBox" MaxLength="32" Margin="0,6,0,14" />
      <TextBlock Text="Account mode" FontSize="13" Foreground="{StaticResource TextSoftBrush}" />
      <ComboBox Name="AccountModeComboBox" Margin="0,6,0,6" SelectedIndex="0">
        <ComboBoxItem Content="normal - Standard account (starting resources)" Tag="normal" />
      </ComboBox>
      <TextBlock Style="{StaticResource HelpTextStyle}" Margin="0,0,0,16" Text="A new account starts from the standard beginning state. Once it exists, use the card print and growth options on the account page whenever you need them." />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Create" Style="{StaticResource AccentButtonStyle}" Width="96" IsDefault="True" Click="CreateButton_OnClick" />
        <Button Content="Cancel" Width="96" IsCancel="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>