<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Background="#00FFFFFF">
            <Border Height="4" Background="{StaticResource LineBrush}" VerticalAlignment="Center" />
            <Track Name="PART_Track" Minimum="{TemplateBinding RangeBase.Minimum}" Maximum="{TemplateBinding RangeBase.Maximum}" Value="{TemplateBinding RangeBase.Value}" IsDirectionReversed="{TemplateBinding Slider.IsDirectionReversed}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Height="4" Background="{StaticResource IceDimBrush}" VerticalAlignment="Center" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="12" Height="18">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border Background="{StaticResource TextSoftBrush}" BorderBrush="{StaticResource IceBrush}" BorderThickness="1" CornerRadius="2" />
                    </ControlTemplate>
                  </Control.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>