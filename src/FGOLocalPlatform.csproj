<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>FGOLocalPlatform</AssemblyName>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Platforms>AnyCPU</Platforms>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- The one place the version is written. The About page and the updater both read it back
         from the assembly, and package.ps1 names the release zip after it. -->
    <Version>1.1.0</Version>
    <!-- Ahead-of-time compiled so the first window appears without waiting for the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <Product>FGOAC scooby</Product>
    <AssemblyTitle>FGOAC scooby</AssemblyTitle>
    <Company>FGOAC scooby</Company>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>Latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649;CS8500;NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>platform.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DeckReaderUI\**\*.cs" />
    <Compile Include="DeckReaderUI.Kancolle\**\*.cs" />
    <Compile Include="FGOLocalPlatform\**\*.cs" />
    <Compile Include="FGOLocalPlatform.PhotoAssets\**\*.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="app.xaml" />
    <Page Include="audiosettingsview.xaml" />
    <Page Include="cardquantitywindow.xaml" />
    <Page Include="cardvariantswindow.xaml" />
    <Page Include="controlsettingsview.xaml" />
    <Page Include="cursorsettingsview.xaml" />
    <Page Include="debugsettingsview.xaml" />
    <Page Include="diagnosticsview.xaml" />
    <Page Include="mainwindow.xaml" />
    <Page Include="newaccountdialog.xaml" />
    <Page Include="photocontrols.xaml" />
    <Page Include="serversettingsview.xaml" />
    <Page Include="summonsettingswindow.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="platform.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="FGOLocalPlatform.CardNames.json" LogicalName="FGOLocalPlatform.CardNames.json" />
    <EmbeddedResource Include="FGOLocalPlatform.CraftEffects.json" LogicalName="FGOLocalPlatform.CraftEffects.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The author's build references a copy of this assembly beside the game. The package is
         the same library at the same assembly identity (0.8.8.0), restored from nuget.org, so
         the project builds on a machine that has no game install. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
